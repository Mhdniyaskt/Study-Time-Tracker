# ============================================================
# Study Time Tracker - Environment Configuration
# ============================================================

# ------------------------------------------------------------
# MongoDB Connection
# ------------------------------------------------------------
# IMPORTANT: MongoDB must be running for this application to work!
#
# Option 1: Local MongoDB (Recommended for Development)
# - Install MongoDB Community Server from: https://www.mongodb.com/try/download/community
# - Start MongoDB service (usually runs automatically after installation)
# - Use the connection string below:
MONGODB_URI=mongodb://localhost:27017/study_tracker

# Option 2: MongoDB Atlas (Cloud Database)
# - Create a free cluster at: https://www.mongodb.com/cloud/atlas/register
# - Get your connection string from Atlas dashboard
# - Replace username, password, and cluster address:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/study_tracker

# ------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------
# Server Port (default: 3000)
PORT=3000

# ------------------------------------------------------------
# Node Environment
# ------------------------------------------------------------
# Set to 'production' to hide error details and stack traces
# Set to 'development' for detailed error messages
NODE_ENV=development
