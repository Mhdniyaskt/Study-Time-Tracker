  <!-- Footer -->
  <footer class="text-center py-6 text-gray-400 dark:text-gray-500 text-sm">
    Study Time Tracker &copy; <%= new Date().getFullYear() %>
  </footer>

  <!-- Chart.js Initialization -->
  <script>
    // Client-side validation for Add Session form
    function validateAddSessionForm(event) {
      let isValid = true;
      
      // Clear all previous errors
      clearAllValidationErrors();
      
      // Get form values
      const subject = document.getElementById('subject').value.trim();
      const hours = parseInt(document.getElementById('hours').value) || 0;
      const minutes = parseInt(document.getElementById('minutes').value) || 0;
      
      // Validate subject
      if (!subject) {
        showValidationError('subject', 'Subject cannot be empty.');
        isValid = false;
      } else if (subject.length < 2 || subject.length > 50) {
        showValidationError('subject', 'Subject must be between 2 and 50 characters.');
        isValid = false;
      }
      
      // Validate hours
      if (hours < 0) {
        showValidationError('hours', 'Hours cannot be negative.');
        isValid = false;
      } else if (hours > 23) {
        showValidationError('hours', 'Hours cannot exceed 23.');
        isValid = false;
      }
      
      // Validate minutes
      if (minutes < 0) {
        showValidationError('minutes', 'Minutes cannot be negative.');
        isValid = false;
      } else if (minutes > 59) {
        showValidationError('minutes', 'Minutes must be between 0 and 59.');
        isValid = false;
      }
      
      // Validate total duration
      if (hours === 0 && minutes === 0) {
        showValidationError('duration', 'Study duration must be greater than 0.');
        isValid = false;
      }
      
      if (!isValid) {
        event.preventDefault();
        return false;
      }
      
      return true;
    }
    
    function showValidationError(fieldId, message) {
      const errorElement = document.getElementById(fieldId + 'Error');
      const inputElement = document.getElementById(fieldId === 'duration' ? 'hours' : fieldId);
      
      if (errorElement) {
        errorElement.textContent = message;
        errorElement.classList.remove('hidden');
      }
      
      if (inputElement) {
        inputElement.classList.remove('border-gray-300', 'focus:ring-indigo-400');
        inputElement.classList.add('border-red-400', 'bg-red-50', 'focus:ring-red-400');
      }
      
      // For duration error, also highlight minutes field
      if (fieldId === 'duration') {
        const minutesElement = document.getElementById('minutes');
        if (minutesElement) {
          minutesElement.classList.remove('border-gray-300', 'focus:ring-indigo-400');
          minutesElement.classList.add('border-red-400', 'bg-red-50', 'focus:ring-red-400');
        }
      }
    }
    
    function clearValidationError(fieldId) {
      const errorElement = document.getElementById(fieldId + 'Error');
      const inputElement = document.getElementById(fieldId);
      
      if (errorElement) {
        errorElement.classList.add('hidden');
      }
      
      if (inputElement) {
        inputElement.classList.remove('border-red-400', 'bg-red-50', 'focus:ring-red-400');
        inputElement.classList.add('border-gray-300', 'focus:ring-indigo-400');
      }
      
      // Also clear duration error when hours or minutes change
      if (fieldId === 'hours' || fieldId === 'minutes') {
        const durationError = document.getElementById('durationError');
        if (durationError) {
          durationError.classList.add('hidden');
        }
        // Reset both fields' styling if they were marked as error for duration
        ['hours', 'minutes'].forEach(id => {
          const element = document.getElementById(id);
          if (element && element.classList.contains('border-red-400')) {
            element.classList.remove('border-red-400', 'bg-red-50', 'focus:ring-red-400');
            element.classList.add('border-gray-300', 'focus:ring-indigo-400');
          }
        });
      }
    }
    
    function clearAllValidationErrors() {
      ['subject', 'hours', 'minutes', 'duration'].forEach(clearValidationError);
    }

    // Get current theme for chart colors
    const isDarkMode = document.documentElement.classList.contains('dark');
    const chartTextColor = isDarkMode ? '#e5e7eb' : '#374151';
    const chartGridColor = isDarkMode ? 'rgba(255, 255, 255, 0.1)' : 'rgba(0, 0, 0, 0.05)';

    // Weekly Chart
    const weeklyCtx = document.getElementById('weeklyChart').getContext('2d');
    const weeklyChart = new Chart(weeklyCtx, {
      type: 'bar',
      data: {
        labels: <%- JSON.stringify(weeklyChartLabels) %>,
        datasets: [{
          label: 'Study Hours',
          data: <%- JSON.stringify(weeklyChartData) %>,
          backgroundColor: 'rgba(99, 102, 241, 0.8)',
          borderColor: 'rgba(99, 102, 241, 1)',
          borderWidth: 1,
          borderRadius: 6,
          maxBarThickness: 60
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                return context.parsed.y + ' hours';
              }
            }
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              color: chartTextColor,
              callback: function(value) {
                return value + 'h';
              }
            },
            grid: {
              color: chartGridColor
            }
          },
          x: {
            ticks: {
              color: chartTextColor
            },
            grid: {
              display: false
            }
          }
        }
      }
    });

    // Monthly Chart
    const monthlyCtx = document.getElementById('monthlyChart').getContext('2d');
    const monthlyChart = new Chart(monthlyCtx, {
      type: 'line',
      data: {
        labels: <%- JSON.stringify(monthlyChartLabels) %>,
        datasets: [{
          label: 'Study Hours',
          data: <%- JSON.stringify(monthlyChartData) %>,
          backgroundColor: 'rgba(16, 185, 129, 0.1)',
          borderColor: 'rgba(16, 185, 129, 1)',
          borderWidth: 2,
          fill: true,
          tension: 0.4,
          pointRadius: 3,
          pointHoverRadius: 5,
          pointBackgroundColor: 'rgba(16, 185, 129, 1)',
          pointBorderColor: isDarkMode ? '#1f2937' : '#fff',
          pointBorderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                return context.parsed.y + ' hours';
              }
            }
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              color: chartTextColor,
              callback: function(value) {
                return value + 'h';
              }
            },
            grid: {
              color: chartGridColor
            }
          },
          x: {
            ticks: {
              color: chartTextColor,
              maxRotation: 0,
              autoSkip: true,
              maxTicksLimit: 15
            },
            grid: {
              display: false
            }
          }
        }
      }
    });

    // ==========================================================================
    // STUDY TIMER IMPLEMENTATION
    // ==========================================================================

    /**
     * Timer State (persisted in localStorage for cross-navigation persistence)
     * - timerState: 'ready' | 'running' | 'paused'
     * - timerSubject: string
     * - timerStartTime: timestamp (when timer was started/resumed)
     * - timerElapsedSeconds: exact accumulated seconds
     */

    let timerState = 'ready';
    let timerSubject = '';
    let timerStartTime = null;
    let timerElapsedSeconds = 0;
    let timerIntervalId = null;

    const TIMER_STORAGE_KEY = 'studyTimerState';

    // DOM Elements
    const timerDisplay = document.getElementById('timerDisplay');
    const timerStatus = document.getElementById('timerStatus');
    const timerSubjectInput = document.getElementById('timerSubject');
    const timerSubjectError = document.getElementById('timerSubjectError');
    const timerWarning = document.getElementById('timerWarning');
    const startBtn = document.getElementById('timerStartBtn');
    const stopBtn = document.getElementById('timerStopBtn');
    const resetBtn = document.getElementById('timerResetBtn');
    const submitBtn = document.getElementById('timerSubmitBtn');
    const submitBtnText = document.getElementById('submitBtnText');

    /**
     * Initialize timer on page load — restore from localStorage if exists
     */
    function initTimer() {
      const saved = localStorage.getItem(TIMER_STORAGE_KEY);
      if (saved) {
        try {
          const state = JSON.parse(saved);
          timerState = state.timerState || 'ready';
          timerSubject = state.timerSubject || '';
          timerStartTime = state.timerStartTime || null;
          timerElapsedSeconds = state.timerElapsedSeconds || 0;

          // Populate subject input
          timerSubjectInput.value = timerSubject;

          // If timer was running, continue it
          if (timerState === 'running' && timerStartTime) {
            // Recalculate elapsed time based on current time
            const now = Date.now();
            const additionalSeconds = Math.floor((now - timerStartTime) / 1000);
            timerElapsedSeconds += additionalSeconds;
            timerStartTime = now; // Reset to now
            startTimerTick();
            updateUI();
          } else if (timerState === 'paused') {
            updateDisplay();
            updateUI();
          }
        } catch (err) {
          console.error('Failed to restore timer state:', err);
          clearAndResetTimer();
        }
      }
    }

    /**
     * Save timer state to localStorage
     */
    function saveTimerState() {
      const state = {
        timerState,
        timerSubject,
        timerStartTime,
        timerElapsedSeconds
      };
      localStorage.setItem(TIMER_STORAGE_KEY, JSON.stringify(state));
    }

    /**
     * Clear timer state from localStorage
     */
    function clearTimerState() {
      localStorage.removeItem(TIMER_STORAGE_KEY);
    }

    /**
     * Format seconds as HH:MM:SS
     */
    function formatTime(totalSeconds) {
      const hours = Math.floor(totalSeconds / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;
      return [hours, minutes, seconds]
        .map(v => String(v).padStart(2, '0'))
        .join(':');
    }

    /**
     * Format seconds as human readable (e.g., "3m 15s", "45s", "1h 5m 30s")
     */
    function formatTimeHuman(totalSeconds) {
      const hours = Math.floor(totalSeconds / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;
      
      const parts = [];
      if (hours > 0) parts.push(`${hours}h`);
      if (minutes > 0) parts.push(`${minutes}m`);
      if (seconds > 0 || parts.length === 0) parts.push(`${seconds}s`);
      
      return parts.join(' ');
    }

    /**
     * Update the timer display with current elapsed time
     */
    function updateDisplay() {
      let currentElapsed = timerElapsedSeconds;
      if (timerState === 'running' && timerStartTime) {
        const now = Date.now();
        const additionalSeconds = Math.floor((now - timerStartTime) / 1000);
        currentElapsed += additionalSeconds;
      }
      timerDisplay.textContent = formatTime(currentElapsed);
    }

    /**
     * Update UI button states and status text
     * Buttons always remain visible - only enabled/disabled state changes
     */
    function updateUI() {
      // Clear any previous warnings
      hideWarning();
      clearSubjectError();

      if (timerState === 'ready') {
        timerStatus.textContent = 'Ready to start';
        timerStatus.className = 'text-xs text-gray-500';
        
        startBtn.disabled = false;
        stopBtn.disabled = true;
        resetBtn.disabled = false;
        submitBtn.disabled = true;
        submitBtnText.textContent = 'Submit';
        
        // Update Stop button label and icon
        stopBtn.querySelector('span:first-child').textContent = '■';
        stopBtn.querySelector('span:last-child').textContent = 'Stop';
        
        timerSubjectInput.disabled = false;
      } else if (timerState === 'running') {
        timerStatus.textContent = 'Running ●';
        timerStatus.className = 'text-xs text-emerald-600 font-medium';
        
        startBtn.disabled = true;
        stopBtn.disabled = false;
        resetBtn.disabled = false;
        submitBtn.disabled = true;
        submitBtnText.textContent = 'Submit';
        
        // Update Stop button to show "Stop" (pause)
        stopBtn.querySelector('span:first-child').textContent = '⏸';
        stopBtn.querySelector('span:last-child').textContent = 'Stop';
        stopBtn.className = 'bg-amber-600 hover:bg-amber-700 disabled:bg-gray-300 disabled:cursor-not-allowed text-white font-medium py-2 rounded-lg text-sm transition flex items-center justify-center gap-1';
        
        timerSubjectInput.disabled = true;
      } else if (timerState === 'paused') {
        timerStatus.textContent = 'Paused';
        timerStatus.className = 'text-xs text-amber-600 font-medium';
        
        startBtn.disabled = true;
        stopBtn.disabled = false;
        resetBtn.disabled = false;
        submitBtn.disabled = false;
        
        // Show exact time that will be added
        const timeStr = formatTimeHuman(timerElapsedSeconds);
        submitBtnText.textContent = `Submit (Add ${timeStr})`;
        
        // Update Stop button to show "Resume"
        stopBtn.querySelector('span:first-child').textContent = '▶';
        stopBtn.querySelector('span:last-child').textContent = 'Resume';
        stopBtn.className = 'bg-emerald-600 hover:bg-emerald-700 disabled:bg-gray-300 disabled:cursor-not-allowed text-white font-medium py-2 rounded-lg text-sm transition flex items-center justify-center gap-1';
        
        timerSubjectInput.disabled = false; // Allow editing subject before submit
      }
    }

    /**
     * Show warning message
     */
    function showWarning(message) {
      timerWarning.querySelector('p').textContent = message;
      timerWarning.classList.remove('hidden');
    }

    /**
     * Hide warning message
     */
    function hideWarning() {
      timerWarning.classList.add('hidden');
    }

    /**
     * Show subject input error
     */
    function showSubjectError(message) {
      timerSubjectError.textContent = message;
      timerSubjectError.classList.remove('hidden');
      timerSubjectInput.classList.remove('border-gray-300', 'focus:ring-indigo-400');
      timerSubjectInput.classList.add('border-red-400', 'bg-red-50', 'focus:ring-red-400');
    }

    /**
     * Clear subject input error
     */
    function clearSubjectError() {
      timerSubjectError.classList.add('hidden');
      timerSubjectInput.classList.remove('border-red-400', 'bg-red-50', 'focus:ring-red-400');
      timerSubjectInput.classList.add('border-gray-300', 'focus:ring-indigo-400');
    }

    /**
     * Start the interval timer tick (every 100ms for smooth updates)
     */
    function startTimerTick() {
      if (timerIntervalId) clearInterval(timerIntervalId);
      timerIntervalId = setInterval(() => {
        updateDisplay();
        saveTimerState();
      }, 100);
    }

    /**
     * Stop the interval timer tick
     */
    function stopTimerTick() {
      if (timerIntervalId) {
        clearInterval(timerIntervalId);
        timerIntervalId = null;
      }
    }

    /**
     * START button handler
     * Validates subject and starts the timer running
     * Does NOT save to database
     */
    function startTimer() {
      // Validate subject
      const subject = timerSubjectInput.value.trim();
      if (!subject) {
        showSubjectError('Subject is required.');
        return;
      }
      if (subject.length < 2) {
        showSubjectError('Subject must be at least 2 characters.');
        return;
      }
      if (subject.length > 50) {
        showSubjectError('Subject must be 50 characters or fewer.');
        return;
      }

      // Start timer
      timerState = 'running';
      timerSubject = subject;
      timerStartTime = Date.now();
      timerElapsedSeconds = 0;

      startTimerTick();
      updateUI();
      saveTimerState();
    }

    /**
     * STOP/RESUME button handler
     * When running: Pauses the timer (freezes elapsed time)
     * When paused: Resumes the timer (continues from paused time)
     * Does NOT save to database
     */
    function stopTimer() {
      if (timerState === 'running') {
        // PAUSE: Calculate and freeze exact elapsed time
        const now = Date.now();
        const additionalSeconds = Math.floor((now - timerStartTime) / 1000);
        timerElapsedSeconds += additionalSeconds;

        timerState = 'paused';
        timerStartTime = null;

        stopTimerTick();
        updateDisplay();
        updateUI();
        saveTimerState();
      } else if (timerState === 'paused') {
        // RESUME: Continue timer from paused elapsed time
        timerState = 'running';
        timerStartTime = Date.now();

        startTimerTick();
        updateUI();
        saveTimerState();
      }
    }

    /**
     * RESET button handler
     * Resets timer back to 00:00:00 WITHOUT saving to database
     * If timer is running, asks for confirmation first
     */
    function resetTimer() {
      // If running, ask for confirmation
      if (timerState === 'running') {
        if (!confirm('Reset the running timer? Your current time will be lost.')) {
          return;
        }
      }

      // Clear and reset everything
      clearAndResetTimer();
    }

    /**
     * Clear all timer data and reset to initial state
     */
    function clearAndResetTimer() {
      timerState = 'ready';
      timerSubject = '';
      timerStartTime = null;
      timerElapsedSeconds = 0;

      stopTimerTick();
      clearTimerState();
      timerSubjectInput.value = '';
      timerDisplay.textContent = '00:00:00';
      updateUI();
    }

    /**
     * SUBMIT button handler
     * This is the ONLY function that saves to MongoDB
     * Saves exact durationSeconds to database
     */
    async function submitTimer() {
      if (timerState !== 'paused') {
        showWarning('Please stop the timer before submitting.');
        return;
      }

      // Re-validate subject (user might have changed it)
      const subject = timerSubjectInput.value.trim();
      if (!subject) {
        showSubjectError('Subject is required.');
        return;
      }
      if (subject.length < 2) {
        showSubjectError('Subject must be at least 2 characters.');
        return;
      }
      if (subject.length > 50) {
        showSubjectError('Subject must be 50 characters or fewer.');
        return;
      }

      // Validate minimum time (at least 1 second)
      const finalElapsed = timerElapsedSeconds;
      if (finalElapsed < 1) {
        showWarning('Timer must run for at least 1 second before submitting.');
        return;
      }

      // Disable the submit button to prevent double-clicks
      submitBtn.disabled = true;
      submitBtnText.textContent = 'Saving...';

      try {
        // Send to server - ONLY time we save to database
        // Send exact seconds - server will store durationSeconds and derive duration (minutes)
        const response = await fetch('/timer/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            subject: subject, // Use current subject value (might have been edited)
            elapsedSeconds: finalElapsed
          })
        });

        const result = await response.json();

        if (response.ok && result.success) {
          // Success — reset timer and reload page to show new session
          clearAndResetTimer();
          window.location.reload();
        } else {
          // Server returned an error
          showWarning(result.error || 'Failed to save session. Please try again.');
          submitBtn.disabled = false;
          const timeStr = formatTimeHuman(finalElapsed);
          submitBtnText.textContent = `Submit (Add ${timeStr})`;
        }
      } catch (err) {
        console.error('Failed to save timer session:', err);
        showWarning('Network error. Please check your connection and try again.');
        submitBtn.disabled = false;
        const timeStr = formatTimeHuman(finalElapsed);
        submitBtnText.textContent = `Submit (Add ${timeStr})`;
      }
    }

    // Clear subject error when user types
    timerSubjectInput.addEventListener('input', clearSubjectError);

    // Initialize timer on page load
    initTimer();

    // ==========================================================================
    // ELECTRON IPC INTEGRATION
    // ==========================================================================

    if (window.electronAPI) {
      // ── Sync dashboard localStorage state → Electron shared state ──────────
      // We patch saveTimerState so every tick/state-change also pushes into
      // the Electron main-process sharedTimerState (which the widget reads).
      const _origSaveTimerState = saveTimerState;
      saveTimerState = function () {
        _origSaveTimerState();
        window.electronAPI.sendTimerAction('update-state', {
          state:          timerState,
          subject:        timerSubject,
          startTime:      timerStartTime,
          elapsedSeconds: timerElapsedSeconds,
        });
      };

      // ── Receive state broadcasts from the main process ──────────────────────
      // The floating widget can pause/resume/reset — we mirror those changes
      // back into the dashboard UI and localStorage.
      window.electronAPI.onTimerState((s) => {
        // Map Electron's sharedTimerState fields to dashboard variables
        timerState          = s.state || 'ready';
        timerSubject        = s.subject || '';
        timerStartTime      = s.startTime || null;
        timerElapsedSeconds = s.elapsedSeconds || 0;

        // Keep the subject input in sync
        timerSubjectInput.value = timerSubject;

        // If the widget resumed the timer, restart the local tick
        if (timerState === 'running' && !timerIntervalId) {
          // Recalculate elapsed from the stored startTime so we don't double-count
          if (timerStartTime) {
            const extra = Math.floor((Date.now() - timerStartTime) / 1000);
            timerElapsedSeconds += extra;
            timerStartTime = Date.now();
          }
          startTimerTick();
        } else if (timerState !== 'running' && timerIntervalId) {
          stopTimerTick();
        }

        updateDisplay();
        updateUI();
        _origSaveTimerState();
      });

      // ── "stop-and-save" from the widget — POST to /timer/save here ──────────
      window.electronAPI.onSaveTimerSession(async ({ subject, elapsedSeconds }) => {
        try {
          const response = await fetch('/timer/save', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ subject, elapsedSeconds }),
          });
          if (response.ok) {
            clearAndResetTimer();
            window.location.reload();
          } else {
            const err = await response.json();
            console.error('Failed to save timer session:', err.error);
            alert('Failed to save study session: ' + err.error);
          }
        } catch (err) {
          console.error('Error saving timer session:', err);
          alert('Network error saving study session. Please try again.');
        }
      });

      // Push current state immediately so the widget is in sync on first open
      window.electronAPI.requestTimerState();
    }

    // ==========================================================================
    // END ELECTRON IPC INTEGRATION
    // ==========================================================================

    // ==========================================================================
    // END TIMER IMPLEMENTATION
    // ==========================================================================

    // ==========================================================================
    // THEME TOGGLE FUNCTIONALITY
    // ==========================================================================

    /**
     * Toggle between light and dark theme
     * Saves preference to localStorage
     */
    function toggleTheme() {
      const html = document.documentElement;
      const currentTheme = html.classList.contains('dark') ? 'dark' : 'light';
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      
      if (newTheme === 'dark') {
        html.classList.add('dark');
      } else {
        html.classList.remove('dark');
      }
      
      localStorage.setItem('theme', newTheme);
      
      // Update Chart.js charts with new theme
      updateChartsTheme(newTheme);
    }

    /**
     * Update Chart.js charts to match current theme
     */
    function updateChartsTheme(theme) {
      const isDark = theme === 'dark';
      const textColor = isDark ? '#e5e7eb' : '#374151';
      const gridColor = isDark ? 'rgba(255, 255, 255, 0.1)' : 'rgba(0, 0, 0, 0.05)';
      
      // Update weekly chart
      if (typeof weeklyChart !== 'undefined' && weeklyChart) {
        weeklyChart.options.scales.y.ticks.color = textColor;
        weeklyChart.options.scales.x.ticks.color = textColor;
        weeklyChart.options.scales.y.grid.color = gridColor;
        weeklyChart.update('none'); // Update without animation
      }
      
      // Update monthly chart
      if (typeof monthlyChart !== 'undefined' && monthlyChart) {
        monthlyChart.options.scales.y.ticks.color = textColor;
        monthlyChart.options.scales.x.ticks.color = textColor;
        monthlyChart.options.scales.y.grid.color = gridColor;
        monthlyChart.update('none');
      }
    }

    // Initialize charts with current theme on page load
    window.addEventListener('DOMContentLoaded', () => {
      const theme = localStorage.getItem('theme') || 
                   (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      updateChartsTheme(theme);
    });

    // ==========================================================================
    // END THEME TOGGLE
    // ==========================================================================

    // ==========================================================================
    // COMPACT WIDGET — state sync, drag, resize, persistence
    // All controls share the exact same timerState/timerElapsedSeconds/etc.
    // No separate timer — the widget is a second view of the main timer.
    // ==========================================================================

    /**
     * openTimerWidget()
     * ─ In Electron:  opens a native BrowserWindow (alwaysOnTop, resizable,
     *                 draggable anywhere on the desktop).
     * ─ In browser:   falls back to the in-page floating div overlay.
     *
     * The green/gray dot on the Widget button shows which path is active:
     *   ● green  = running inside Electron  → native desktop window
     *   ● gray   = running in browser only  → in-page div overlay
     */
    function openTimerWidget() {
      if (window.electronAPI) {
        console.log('[Widget] Electron detected — opening native BrowserWindow widget');
        // Push current timer state to the main process so the widget opens
        // already showing the right time and subject.
        window.electronAPI.sendTimerAction('update-state', {
          state:          timerState,
          subject:        timerSubject,
          startTime:      timerStartTime,
          elapsedSeconds: timerElapsedSeconds,
        });
        window.electronAPI.openFloatingWidget();
      } else {
        console.log('[Widget] No Electron API — using in-page overlay fallback');
        openCompactWidget();   // plain-browser fallback
      }
    }

    /**
     * Update the Widget button badge and label to reflect the actual runtime.
     * Runs once after the page is ready, so the user always knows which mode
     * they are in without opening the browser console.
     */
    function initWidgetButtonBadge() {
      const badge = document.getElementById('widgetRuntimeBadge');
      const label = document.getElementById('widgetBtnLabel');
      const btn   = document.getElementById('openWidgetBtn');
      if (!badge || !label || !btn) return;

      if (window.electronAPI) {
        // Green dot — native desktop widget available
        badge.style.background = '#4ade80';
        badge.title = 'Electron: native desktop widget';
        label.textContent = 'Desktop Widget';
        btn.title = 'Open as a native desktop window (always on top, draggable anywhere)';
        console.log('[Runtime] Electron detected — window.electronAPI is available');
      } else {
        // Gray dot — browser-only, in-page overlay will be used
        badge.style.background = '#9ca3af';
        badge.title = 'Browser-only mode — run via: npm run electron';
        label.textContent = 'Widget';
        btn.title = 'In-page widget (browser mode). Run "npm run electron" for a true desktop widget.';
        console.warn('[Runtime] No Electron API — running in plain browser. ' +
          'To get the native desktop widget, launch with: npm run electron');
      }
    }

    // Run the badge update as soon as the DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initWidgetButtonBadge);
    } else {
      initWidgetButtonBadge();
    }

    const WIDGET_POS_KEY  = 'compactWidgetPos';
    const widget          = document.getElementById('compactWidget');
    const wTimeEl         = document.getElementById('wTime');
    const wStatusEl       = document.getElementById('wStatus');
    const wSubjectEl      = document.getElementById('wSubject');
    const wStartBtn       = document.getElementById('wStartBtn');
    const wPauseBtn       = document.getElementById('wPauseBtn');
    const wResumeBtn      = document.getElementById('wResumeBtn');

    /** Update the widget clock face + status + subject label */
    function updateWidget() {
      if (!widget || widget.style.display === 'none') return;

      // Time display — live-computed same as the main display
      let currentElapsed = timerElapsedSeconds;
      if (timerState === 'running' && timerStartTime) {
        currentElapsed += Math.floor((Date.now() - timerStartTime) / 1000);
      }
      wTimeEl.textContent = formatTime(currentElapsed);

      // Subject
      wSubjectEl.textContent = timerState === 'ready'
        ? '📚 No subject'
        : '📚 ' + (timerSubject || 'No subject');

      // Status dot + button visibility
      wStartBtn.style.display  = 'none';
      wPauseBtn.style.display  = 'none';
      wResumeBtn.style.display = 'none';

      if (timerState === 'ready') {
        wStatusEl.textContent = 'Ready';
        wStatusEl.style.color = '#666';
        wStartBtn.style.display = 'flex';
      } else if (timerState === 'running') {
        wStatusEl.textContent = '● Running';
        wStatusEl.style.color = '#4ade80';
        wPauseBtn.style.display = 'flex';
      } else if (timerState === 'paused') {
        wStatusEl.textContent = '⏸ Paused';
        wStatusEl.style.color = '#fbbf24';
        wResumeBtn.style.display = 'flex';
      }
    }

    // Widget start — needs a subject from the main input
    function wStart() {
      const subject = timerSubjectInput.value.trim();
      if (!subject) {
        // Bring focus back to main timer and show error
        restoreFullTimer();
        setTimeout(() => {
          showSubjectError('Enter a subject before starting.');
          timerSubjectInput.focus();
        }, 80);
        return;
      }
      startTimer();         // calls the main timer function
      updateWidget();
    }

    function wPause()  { stopTimer();  updateWidget(); }  // stopTimer() toggles pause/resume
    function wResume() { stopTimer();  updateWidget(); }
    function wReset()  { resetTimer(); updateWidget(); }

    /** Open the compact widget (show it, restore saved position/size) */
    function openCompactWidget() {
      // Restore saved position/size
      try {
        const saved = JSON.parse(localStorage.getItem(WIDGET_POS_KEY) || 'null');
        if (saved) {
          if (saved.top  != null) widget.style.top    = saved.top  + 'px';
          if (saved.left != null) widget.style.left   = saved.left + 'px';
          // Only restore right/bottom if position was saved; clear defaults
          if (saved.top  != null) widget.style.right  = 'unset';
          if (saved.width  != null) widget.style.width  = saved.width  + 'px';
          if (saved.height != null) widget.style.height = saved.height + 'px';
        }
      } catch (_) {}

      widget.style.display = 'block';
      updateWidget();

      // Clamp to viewport so it doesn't open off-screen
      requestAnimationFrame(clampWidgetToViewport);
    }

    /** Close widget — does NOT touch timer state at all */
    function closeCompactWidget() {
      saveWidgetPosition();
      widget.style.display = 'none';
    }

    /** Restore full timer view: scroll the timer card into view and close widget */
    function restoreFullTimer() {
      closeCompactWidget();
      // Scroll main timer card into view smoothly
      const timerCard = timerDisplay && timerDisplay.closest
        ? timerDisplay.closest('.bg-white, .dark\\:bg-gray-800')
        : null;
      if (timerCard) {
        timerCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    /** Save current widget position/size to localStorage */
    function saveWidgetPosition() {
      if (!widget) return;
      const rect = widget.getBoundingClientRect();
      localStorage.setItem(WIDGET_POS_KEY, JSON.stringify({
        top:    Math.round(rect.top),
        left:   Math.round(rect.left),
        width:  Math.round(rect.width),
        height: Math.round(rect.height)
      }));
    }

    /** Keep widget fully inside the viewport */
    function clampWidgetToViewport() {
      const rect = widget.getBoundingClientRect();
      const vw   = window.innerWidth;
      const vh   = window.innerHeight;
      let top  = rect.top;
      let left = rect.left;
      if (left + rect.width > vw)  left = vw  - rect.width  - 8;
      if (top  + rect.height > vh) top  = vh  - rect.height - 8;
      if (left < 8)  left = 8;
      if (top  < 8)  top  = 8;
      widget.style.top  = top  + 'px';
      widget.style.left = left + 'px';
      widget.style.right = 'unset';
    }

    // ------------------------------------------------------------------
    // Drag logic — mousedown on title bar
    // ------------------------------------------------------------------
    (function () {
      const titleBar = document.getElementById('widgetTitleBar');
      let dragging = false, ox = 0, oy = 0;

      titleBar.addEventListener('mousedown', function (e) {
        // Ignore clicks on the inner buttons
        if (e.target !== titleBar && e.target !== wSubjectEl) return;
        dragging = true;
        const rect = widget.getBoundingClientRect();
        ox = e.clientX - rect.left;
        oy = e.clientY - rect.top;
        widget.style.right  = 'unset';
        widget.style.bottom = 'unset';
        e.preventDefault();
      });

      document.addEventListener('mousemove', function (e) {
        if (!dragging) return;
        let newLeft = e.clientX - ox;
        let newTop  = e.clientY - oy;
        // Clamp
        const vw = window.innerWidth, vh = window.innerHeight;
        const w  = widget.offsetWidth, h = widget.offsetHeight;
        newLeft = Math.max(0, Math.min(newLeft, vw - w));
        newTop  = Math.max(0, Math.min(newTop,  vh - h));
        widget.style.left = newLeft + 'px';
        widget.style.top  = newTop  + 'px';
      });

      document.addEventListener('mouseup', function () {
        if (dragging) { dragging = false; saveWidgetPosition(); }
      });

      // Touch support
      titleBar.addEventListener('touchstart', function (e) {
        if (e.target !== titleBar && e.target !== wSubjectEl) return;
        dragging = true;
        const rect = widget.getBoundingClientRect();
        ox = e.touches[0].clientX - rect.left;
        oy = e.touches[0].clientY - rect.top;
        widget.style.right  = 'unset';
        widget.style.bottom = 'unset';
      }, { passive: true });

      document.addEventListener('touchmove', function (e) {
        if (!dragging) return;
        const vw = window.innerWidth, vh = window.innerHeight;
        const w  = widget.offsetWidth, h = widget.offsetHeight;
        let newLeft = e.touches[0].clientX - ox;
        let newTop  = e.touches[0].clientY - oy;
        newLeft = Math.max(0, Math.min(newLeft, vw - w));
        newTop  = Math.max(0, Math.min(newTop,  vh - h));
        widget.style.left = newLeft + 'px';
        widget.style.top  = newTop  + 'px';
      }, { passive: true });

      document.addEventListener('touchend', function () {
        if (dragging) { dragging = false; saveWidgetPosition(); }
      });
    })();

    // ------------------------------------------------------------------
    // Resize observer — save whenever the user resizes the widget
    // ------------------------------------------------------------------
    if (typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(() => {
        if (widget.style.display !== 'none') saveWidgetPosition();
      }).observe(widget);
    }

    // ------------------------------------------------------------------
    // Patch the existing tick so the widget also refreshes every 100 ms
    // ------------------------------------------------------------------
    const _origStartTick = startTimerTick;
    startTimerTick = function () {
      _origStartTick();
      // The existing interval already calls updateDisplay() + saveTimerState().
      // We piggyback widget update inside timerIntervalId by patching the tick.
    };

    // Simpler: hook into updateDisplay so widget is always in sync
    const _origUpdateDisplay = updateDisplay;
    updateDisplay = function () {
      _origUpdateDisplay();
      updateWidget();
    };

    // Also hook updateUI so button states stay in sync
    const _origUpdateUI = updateUI;
    updateUI = function () {
      _origUpdateUI();
      updateWidget();
    };

    // Button hover micro-animations
    [wStartBtn, wPauseBtn, wResumeBtn].forEach(btn => {
      btn.addEventListener('mouseenter', () => { btn.style.transform = 'scale(1.08)'; });
      btn.addEventListener('mouseleave', () => { btn.style.transform = 'scale(1)';    });
      btn.addEventListener('mousedown',  () => { btn.style.transform = 'scale(0.94)'; });
      btn.addEventListener('mouseup',    () => { btn.style.transform = 'scale(1.08)'; });
    });

    // ==========================================================================
    // END COMPACT WIDGET
    // ==========================================================================
  </script>

</body>
</html>
