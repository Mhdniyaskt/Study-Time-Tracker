<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Study Time Tracker</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script>
    // Theme initialization - runs before page renders to prevent flash
    (function() {
      const theme = localStorage.getItem('theme') || 
                   (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      }
    })();
    
    // Configure Tailwind dark mode
    tailwind.config = {
      darkMode: 'class',
    };
  </script>
  <style>
    /* Placeholder text color for dark mode */
    .dark input::placeholder {
      color: #9ca3af; /* gray-400 */
      opacity: 1;
    }
    .dark textarea::placeholder {
      color: #9ca3af; /* gray-400 */
      opacity: 1;
    }
  </style>
</head>
<body class="bg-gray-50 dark:bg-gray-900 min-h-screen transition-colors duration-200">

  <!-- Compact Header -->
  <header class="bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 sticky top-0 z-10 transition-colors duration-200">
    <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-indigo-600 dark:text-indigo-400">Study Time Tracker</h1>
        <p class="text-xs text-gray-500 dark:text-gray-400">Track your progress and stay consistent</p>
      </div>
      <div class="flex items-center gap-2">
        <!-- Theme Toggle -->
        <button
          id="themeToggle"
          onclick="toggleTheme()"
          class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 rounded-lg transition"
          title="Toggle theme">
          <svg id="themeIconLight" class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg id="themeIconDark" class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <span id="themeText" class="hidden sm:inline">
            <span class="dark:hidden">Dark</span>
            <span class="hidden dark:inline">Light</span>
          </span>
        </button>
        <a
          href="/statistics"
          class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 rounded-lg transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
          Statistics
        </a>
        <a
          href="/history"
          class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 rounded-lg transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z" />
          </svg>
          History
        </a>
        <button
          onclick="document.getElementById('settingsModal').classList.toggle('hidden')"
          class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 rounded-lg transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Settings
        </button>
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <div class="max-w-7xl mx-auto px-4 py-6 space-y-6">

    <!-- Statistics Row -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      
      <!-- Today's Study -->
      <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-4 shadow-sm transition-colors duration-200">
        <div class="flex items-center gap-3 mb-2">
          <div class="bg-indigo-100 dark:bg-indigo-900 rounded-lg p-2">
            <svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z" />
            </svg>
          </div>
          <span class="text-sm font-medium text-gray-600 dark:text-gray-300">Today's Study</span>
        </div>
        <div class="mb-2">
          <% const todayHours = Math.floor(todayTotal / 60); %>
          <% const todayMins = todayTotal % 60; %>
          <p class="text-2xl font-bold text-gray-800 dark:text-gray-100">
            <%= todayHours > 0 ? todayHours + 'h ' : '' %><%= todayMins + 'm' %>
          </p>
          <% const dgh = Math.floor(dailyGoal / 60); %>
          <p class="text-xs text-gray-500 dark:text-gray-400">Goal: <%= dgh %>h</p>
        </div>
        <div class="w-full bg-gray-100 dark:bg-gray-700 rounded-full h-1.5">
          <div class="h-1.5 bg-indigo-500 dark:bg-indigo-400 rounded-full transition-all" style="width: <%= dailyProgress %>%"></div>
        </div>
      </div>

      <!-- This Week -->
      <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-4 shadow-sm transition-colors duration-200">
        <div class="flex items-center gap-3 mb-2">
          <div class="bg-emerald-100 dark:bg-emerald-900 rounded-lg p-2">
            <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
            </svg>
          </div>
          <span class="text-sm font-medium text-gray-600 dark:text-gray-300">This Week</span>
        </div>
        <div>
          <%
            const wh = Math.floor(weeklyTotal / 60);
            const wm = weeklyTotal % 60;
          %>
          <p class="text-2xl font-bold text-gray-800 dark:text-gray-100">
            <%= wh > 0 ? wh + 'h ' : '' %><%= wm + 'm' %>
          </p>
          <p class="text-xs text-gray-500 dark:text-gray-400">Total study time</p>
        </div>
      </div>

      <!-- This Month -->
      <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-4 shadow-sm transition-colors duration-200">
        <div class="flex items-center gap-3 mb-2">
          <div class="bg-sky-100 dark:bg-sky-900 rounded-lg p-2">
            <svg class="w-5 h-5 text-sky-600 dark:text-sky-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
            </svg>
          </div>
          <span class="text-sm font-medium text-gray-600 dark:text-gray-300">This Month</span>
        </div>
        <div>
          <%
            const mh = Math.floor(monthlyTotal / 60);
            const mm = monthlyTotal % 60;
          %>
          <p class="text-2xl font-bold text-gray-800 dark:text-gray-100">
            <%= mh > 0 ? mh + 'h ' : '' %><%= mm + 'm' %>
          </p>
          <p class="text-xs text-gray-500 dark:text-gray-400"><%= monthlySessions %> <%= monthlySessions === 1 ? 'session' : 'sessions' %></p>
        </div>
      </div>

      <!-- Overall Total -->
      <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-4 shadow-sm transition-colors duration-200">
        <div class="flex items-center gap-3 mb-2">
          <div class="bg-violet-100 dark:bg-violet-900 rounded-lg p-2">
            <svg class="w-5 h-5 text-violet-600 dark:text-violet-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zm6.75-9.75C9.75 2.754 10.254 2.25 10.875 2.25h2.25c.621 0 1.125.504 1.125 1.125v16.5c0 .621-.504 1.125-1.125 1.125h-2.25A1.125 1.125 0 019.75 19.875V3.375zm6.75 4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.625c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.25z" />
            </svg>
          </div>
          <span class="text-sm font-medium text-gray-600 dark:text-gray-300">Overall Total</span>
        </div>
        <div>
          <% const totalHours = Math.floor(totalStudyTime / 60); %>
          <% const totalMins = totalStudyTime % 60; %>
          <p class="text-2xl font-bold text-gray-800 dark:text-gray-100">
            <%= totalHours > 0 ? totalHours + 'h ' : '' %><%= totalMins + 'm' %>
          </p>
          <p class="text-xs text-gray-500 dark:text-gray-400">All time</p>
        </div>
      </div>

      <!-- Study Streak -->
      <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-4 shadow-sm transition-colors duration-200">
        <div class="flex items-center gap-3 mb-2">
          <div class="<%= currentStreak > 0 ? 'bg-orange-100 dark:bg-orange-900' : 'bg-gray-100 dark:bg-gray-700' %> rounded-lg p-2">
            <span class="text-2xl">🔥</span>
          </div>
          <span class="text-sm font-medium text-gray-600 dark:text-gray-300">Study Streak</span>
        </div>
        <div>
          <p class="text-2xl font-bold <%= currentStreak > 0 ? 'text-orange-600 dark:text-orange-400' : 'text-gray-400 dark:text-gray-500' %>">
            <%= currentStreak %> <%= currentStreak === 1 ? 'day' : 'days' %>
          </p>
          <p class="text-xs text-gray-500 dark:text-gray-400">
            <%= currentStreak > 0 ? 'Keep going!' : 'Reach your goal today' %>
          </p>
        </div>
      </div>

    </div>

    <!-- 3-Column Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- LEFT: Add Study Session Form -->
      <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-gray-700 mb-4">Add Study Session</h2>

        <%# ---- Validation error banner ---- %>
        <% if (typeof formErrors !== 'undefined' && formErrors.length > 0) { %>
          <div class="mb-4 rounded-lg border border-red-200 bg-red-50 p-3">
            <p class="text-xs font-semibold text-red-700 mb-1">Please fix the following:</p>
            <ul class="list-disc list-inside space-y-0.5">
              <% formErrors.forEach(e => { %>
                <li class="text-xs text-red-600"><%= e %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <form method="POST" action="/study" class="space-y-4" id="addSessionForm" onsubmit="return validateAddSessionForm(event)">
          <!-- Subject -->
          <div>
            <label for="subject" class="block text-sm font-medium text-gray-600 mb-1">Subject</label>
            <%
              const subjectVal   = (typeof formValues !== 'undefined' && formValues) ? formValues.subject : '';
              const subjectError = (typeof formErrors !== 'undefined') && formErrors.some(e => e.toLowerCase().includes('subject'));
            %>
            <input
              type="text"
              id="subject"
              name="subject"
              placeholder="e.g. Mathematics, History..."
              value="<%= subjectVal %>"
              required
              class="w-full border rounded-lg px-3 py-2 text-sm text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-700 focus:outline-none focus:ring-2 focus:border-transparent transition
                     <%= subjectError ? 'border-red-400 bg-red-50 focus:ring-red-400' : 'border-gray-300 dark:border-gray-600 focus:ring-indigo-400' %>"
              oninput="clearValidationError('subject')"
            />
            <p id="subjectError" class="mt-1 text-xs text-red-500 hidden"></p>
            <% if (subjectError) { %>
              <p class="mt-1 text-xs text-red-500">Subject must be 2–50 characters.</p>
            <% } %>
          </div>

          <!-- Hours & Minutes -->
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="hours" class="block text-sm font-medium text-gray-600 mb-1">Hours</label>
              <%
                const hoursVal   = (typeof formValues !== 'undefined' && formValues) ? formValues.hours : '';
                const hoursError = (typeof formErrors !== 'undefined') && formErrors.some(e => e.toLowerCase().includes('hour'));
              %>
              <input
                type="number"
                id="hours"
                name="hours"
                min="0"
                max="23"
                placeholder="0"
                value="<%= hoursVal %>"
                class="w-full border rounded-lg px-3 py-2 text-sm text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-700 focus:outline-none focus:ring-2 focus:border-transparent transition
                       <%= hoursError ? 'border-red-400 bg-red-50 focus:ring-red-400' : 'border-gray-300 dark:border-gray-600 focus:ring-indigo-400' %>"
                oninput="clearValidationError('hours')"
              />
              <p id="hoursError" class="mt-1 text-xs text-red-500 hidden"></p>
            </div>
            <div>
              <label for="minutes" class="block text-sm font-medium text-gray-600 mb-1">Minutes</label>
              <%
                const minutesVal   = (typeof formValues !== 'undefined' && formValues) ? formValues.minutes : '';
                const minutesError = (typeof formErrors !== 'undefined') && formErrors.some(e => e.toLowerCase().includes('minute'));
              %>
              <input
                type="number"
                id="minutes"
                name="minutes"
                min="0"
                max="59"
                placeholder="0"
                value="<%= minutesVal %>"
                class="w-full border rounded-lg px-3 py-2 text-sm text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-700 focus:outline-none focus:ring-2 focus:border-transparent transition
                       <%= minutesError ? 'border-red-400 bg-red-50 focus:ring-red-400' : 'border-gray-300 dark:border-gray-600 focus:ring-indigo-400' %>"
                oninput="clearValidationError('minutes')"
              />
              <p id="minutesError" class="mt-1 text-xs text-red-500 hidden"></p>
            </div>
          </div>

          <!-- Duration Error (for when both hours and minutes are 0) -->
          <p id="durationError" class="text-xs text-red-500 hidden"></p>

          <!-- Submit -->
          <button
            type="submit"
            class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 rounded-lg text-sm transition">
            Add Study Session
          </button>
        </form>
      </div>

      <!-- MIDDLE: Study Timer -->
      <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-6 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-semibold text-gray-700 dark:text-gray-200">Study Timer</h2>
          <!-- Pop-out widget button -->
          <button
            id="openWidgetBtn"
            onclick="openTimerWidget()"
            title="Open compact timer widget"
            class="flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-medium text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 bg-gray-100 dark:bg-gray-700 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 border border-gray-200 dark:border-gray-600 hover:border-indigo-300 dark:hover:border-indigo-600 rounded-lg transition">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8V5a2 2 0 012-2h3M16 3h3a2 2 0 012 2v3M21 16v3a2 2 0 01-2 2h-3M8 21H5a2 2 0 01-2-2v-3" />
            </svg>
            <!-- Label swaps at runtime: "Desktop Widget" in Electron, "Widget" in browser -->
            <span id="widgetBtnLabel">Widget</span>
            <!-- Runtime badge: green dot = Electron, gray dot = browser-only -->
            <span id="widgetRuntimeBadge"
                  title="Runtime: browser-only (run via npm run electron for desktop widget)"
                  style="width:6px;height:6px;border-radius:50%;background:#9ca3af;flex-shrink:0;"></span>
          </button>
        </div>

        <!-- Timer Display -->
        <div class="text-center mb-4">
          <div id="timerDisplay" class="text-5xl font-bold text-gray-800 dark:text-gray-100 font-mono tracking-tight mb-2">
            00:00:00
          </div>
          <p id="timerStatus" class="text-xs text-gray-500">Ready to start</p>
        </div>

        <!-- Subject Input for Timer -->
        <div class="mb-4">
          <label for="timerSubject" class="block text-sm font-medium text-gray-600 mb-1">Subject</label>
          <input
            type="text"
            id="timerSubject"
            placeholder="e.g. Mathematics, History..."
            class="w-full border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg px-3 py-2 text-sm text-gray-700 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent transition"
          />
          <p id="timerSubjectError" class="mt-1 text-xs text-red-500 hidden"></p>
        </div>

        <!-- Timer Control Buttons (Stable Layout - Always Visible) -->
        <div class="grid grid-cols-3 gap-2 mb-2">
          <button
            id="timerStartBtn"
            onclick="startTimer()"
            class="bg-emerald-600 hover:bg-emerald-700 disabled:bg-gray-300 disabled:cursor-not-allowed text-white font-medium py-2 rounded-lg text-sm transition flex items-center justify-center gap-1">
            <span>▶</span>
            <span>Start</span>
          </button>
          
          <button
            id="timerStopBtn"
            onclick="stopTimer()"
            disabled
            class="bg-red-600 hover:bg-red-700 disabled:bg-gray-300 disabled:cursor-not-allowed text-white font-medium py-2 rounded-lg text-sm transition flex items-center justify-center gap-1">
            <span>■</span>
            <span>Stop</span>
          </button>
          
          <button
            id="timerResetBtn"
            onclick="resetTimer()"
            class="bg-gray-500 hover:bg-gray-600 disabled:bg-gray-300 disabled:cursor-not-allowed text-white font-medium py-2 rounded-lg text-sm transition flex items-center justify-center gap-1">
            <span>↻</span>
            <span>Reset</span>
          </button>
        </div>

        <!-- Submit Button (Full Width) -->
        <button
          id="timerSubmitBtn"
          onclick="submitTimer()"
          disabled
          class="w-full bg-indigo-600 hover:bg-indigo-700 disabled:bg-gray-300 disabled:cursor-not-allowed text-white font-medium py-2.5 rounded-lg text-sm transition flex items-center justify-center gap-2">
          <span>✓</span>
          <span id="submitBtnText">Submit</span>
        </button>

        <!-- Info Message -->
        <p class="text-xs text-gray-500 text-center mt-3">
          ⓘ Stop pauses the timer. Click Submit when done to save your study time.
        </p>

        <!-- Timer Warning Message -->
        <div id="timerWarning" class="hidden mt-4 rounded-lg border border-amber-200 bg-amber-50 p-3">
          <p class="text-xs text-amber-800"></p>
        </div>
      </div>

      <!-- RIGHT: Study by Subject -->
      <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-gray-700 mb-4">Study by Subject</h2>
        
        <% if (subjectStats.length > 0) { %>
          <%
            // Find the highest study time for progress bar calculation
            const maxMinutes = subjectStats[0].totalMinutes;
          %>
          <div class="space-y-3">
            <% subjectStats.forEach(stat => { %>
              <%
                const statHours = Math.floor(stat.totalMinutes / 60);
                const statMins = stat.totalMinutes % 60;
                const statTimeStr = (statHours > 0 ? statHours + 'h ' : '') + statMins + 'm';
                const progressWidth = maxMinutes > 0 ? Math.round((stat.totalMinutes / maxMinutes) * 100) : 0;
              %>
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-sm font-medium text-gray-700"><%= stat.subject %></span>
                  <span class="text-sm font-semibold text-indigo-600 dark:text-indigo-400"><%= statTimeStr %></span>
                </div>
                <div class="w-full bg-gray-100 rounded-full h-2 overflow-hidden">
                  <div
                    class="h-2 bg-indigo-500 rounded-full transition-all duration-500"
                    style="width: <%= progressWidth %>%">
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-8 text-gray-400">
            <svg class="w-12 h-12 mx-auto mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
            </svg>
            <p class="text-sm">No study data yet</p>
          </div>
        <% } %>
      </div>

    </div>

    <!-- Weekly Study Chart -->
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-gray-700 mb-4">Weekly Study Chart</h2>
      <div class="w-full h-64 sm:h-80">
        <canvas id="weeklyChart"></canvas>
      </div>
    </div>

    <!-- Monthly Study Chart -->
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-gray-700 mb-4">Monthly Study Chart</h2>
      <div class="w-full h-64 sm:h-80">
        <canvas id="monthlyChart"></canvas>
      </div>
    </div>

    <!-- Study History -->
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-gray-700 mb-4">Study History</h2>

      <% if (groupedSessions.length === 0) { %>
        <!-- Empty state -->
        <div class="text-center py-12 text-gray-400">
          <svg class="w-14 h-14 mx-auto mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z" />
          </svg>
          <p class="text-base">No study sessions yet</p>
          <p class="text-sm mt-1">Add your first session above</p>
        </div>
      <% } else { %>
        <div class="space-y-4">
          <% groupedSessions.forEach(group => { %>
            <%
              const dh = Math.floor(group.total / 60);
              const dm = group.total % 60;
              const dailyTotalStr = (dh > 0 ? dh + 'h ' : '') + dm + 'm';
            %>
            <div class="border border-gray-200 rounded-lg overflow-hidden">

              <!-- Date header -->
              <div class="flex items-center justify-between px-4 py-2.5 bg-gray-50 border-b border-gray-200">
                <span class="text-sm font-semibold text-gray-700"><%= group.label %></span>
                <span class="text-xs font-medium text-indigo-600 bg-indigo-50 px-2 py-1 rounded">
                  Total: <%= dailyTotalStr %>
                </span>
              </div>

              <!-- Sessions for this day -->
              <div class="divide-y divide-gray-100">
                <% group.sessions.forEach(session => { %>
                  <%
                    const h = Math.floor(session.duration / 60);
                    const m = session.duration % 60;
                    const durationStr = (h > 0 ? h + 'h ' : '') + m + 'm';
                  %>
                  <div class="px-4 py-3 flex items-center justify-between gap-4 hover:bg-gray-50 transition">
                    <div class="flex items-center gap-3 min-w-0 flex-1">
                      <div class="bg-indigo-100 text-indigo-600 rounded-lg p-2 shrink-0">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                        </svg>
                      </div>
                      <p class="text-sm font-medium text-gray-700 truncate"><%= session.subject %></p>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                      <span class="text-sm font-medium text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded">
                        <%= durationStr %>
                      </span>
                      <a
                        href="/study/<%= session._id %>/edit"
                        class="text-xs text-gray-600 hover:text-indigo-600 hover:bg-indigo-50 border border-gray-300 hover:border-indigo-300 px-2 py-1 rounded transition">
                        Edit
                      </a>
                      <form method="POST" action="/study/<%= session._id %>?_method=DELETE" class="inline">
                        <button
                          type="submit"
                          onclick="return confirm('Delete this session?')"
                          class="text-xs text-gray-600 hover:text-red-600 hover:bg-red-50 border border-gray-300 hover:border-red-300 px-2 py-1 rounded transition">
                          Delete
                        </button>
                      </form>
                    </div>
                  </div>
                <% }) %>
              </div>

            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

  </div>

  <!-- ========================================================
       COMPACT FLOATING TIMER WIDGET
       Dark overlay — Windows Clock compact-overlay style
       Draggable, resizable, position/size persisted in localStorage
       Timer state is fully shared with the main dashboard timer
       ======================================================== -->
  <div
    id="compactWidget"
    style="display:none; position:fixed; z-index:9000; top:20px; right:20px;
           width:220px; min-width:180px; min-height:140px;
           background:#1a1a1a; border-radius:12px;
           box-shadow:0 8px 32px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.08);
           font-family: 'Segoe UI', system-ui, sans-serif;
           color:#fff; overflow:hidden; resize:both; user-select:none;">

    <!-- Drag handle / title bar -->
    <div id="widgetTitleBar"
         style="display:flex; align-items:center; justify-content:space-between;
                padding:8px 10px 6px; background:#141414; cursor:move; gap:6px;">
      <!-- Subject label -->
      <span id="wSubject"
            style="font-size:11px; color:#888; flex:1;
                   white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
        📚 No subject
      </span>
      <!-- Restore full timer -->
      <button onclick="restoreFullTimer()"
              title="Restore full timer"
              style="background:transparent; border:none; color:#888; cursor:pointer;
                     padding:2px; border-radius:4px; display:flex; align-items:center; line-height:1;">
        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M4 8V5a1 1 0 011-1h3M20 8V5a1 1 0 00-1-1h-3M4 16v3a1 1 0 001 1h3M20 16v3a1 1 0 01-1 1h-3"/>
        </svg>
      </button>
      <!-- Close (does NOT reset timer) -->
      <button onclick="closeCompactWidget()"
              title="Close widget (timer keeps running)"
              style="background:transparent; border:none; color:#888; cursor:pointer;
                     padding:2px 3px; border-radius:4px; font-size:16px; line-height:1;">
        ×
      </button>
    </div>

    <!-- Clock display -->
    <div style="text-align:center; padding:10px 12px 4px;">
      <div id="wTime"
           style="font-size:36px; font-weight:300; letter-spacing:1px;
                  font-variant-numeric:tabular-nums; line-height:1; color:#fff;">
        00:00:00
      </div>
      <div style="font-size:9px; color:#555; letter-spacing:6px; margin-top:2px; text-transform:uppercase;">
        hr&nbsp;&nbsp;&nbsp;min&nbsp;&nbsp;&nbsp;sec
      </div>
    </div>

    <!-- Status line -->
    <div id="wStatus"
         style="text-align:center; font-size:10px; color:#666; min-height:14px; padding:2px 0 4px;">
      Ready
    </div>

    <!-- Controls -->
    <div style="display:flex; justify-content:center; gap:12px; padding:6px 12px 14px;">
      <!-- Start button (shown when ready) -->
      <button id="wStartBtn"
              onclick="wStart()"
              title="Start"
              style="width:40px; height:40px; border-radius:50%; border:none; cursor:pointer;
                     background:#e86c3a; color:#fff; font-size:16px;
                     display:flex; align-items:center; justify-content:center;
                     transition:transform .15s, background .15s;">
        ▶
      </button>
      <!-- Pause button (shown when running) -->
      <button id="wPauseBtn"
              onclick="wPause()"
              title="Pause"
              style="width:40px; height:40px; border-radius:50%; border:none; cursor:pointer;
                     background:#e86c3a; color:#fff; font-size:14px;
                     display:none; align-items:center; justify-content:center;
                     transition:transform .15s, background .15s;">
        ⏸
      </button>
      <!-- Resume button (shown when paused) -->
      <button id="wResumeBtn"
              onclick="wResume()"
              title="Resume"
              style="width:40px; height:40px; border-radius:50%; border:none; cursor:pointer;
                     background:#4ade80; color:#111; font-size:16px;
                     display:none; align-items:center; justify-content:center;
                     transition:transform .15s, background .15s;">
        ▶
      </button>
      <!-- Reset -->
      <button id="wResetBtn"
              onclick="wReset()"
              title="Reset"
              style="width:40px; height:40px; border-radius:50%; border:none; cursor:pointer;
                     background:#333; color:#aaa; font-size:16px;
                     display:flex; align-items:center; justify-content:center;
                     transition:transform .15s, background .15s;">
        ↻
      </button>
    </div>
  </div>

  <!-- Settings Modal -->
  <div id="settingsModal" class="hidden fixed inset-0 bg-black bg-opacity-50 dark:bg-opacity-70 z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl max-w-md w-full p-6 transition-colors duration-200">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-semibold text-gray-700 dark:text-gray-200">Settings</h2>
        <button
          onclick="document.getElementById('settingsModal').classList.add('hidden')"
