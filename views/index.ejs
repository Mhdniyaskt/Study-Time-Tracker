<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Study Time Tracker</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body class="bg-gray-50 min-h-screen">

  <!-- Compact Header -->
  <header class="bg-white border-b border-gray-200 sticky top-0 z-10">
    <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-indigo-600">Study Time Tracker</h1>
        <p class="text-xs text-gray-500">Track your progress and stay consistent</p>
      </div>
      <div class="flex items-center gap-2">
        <a
          href="/statistics"
          class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
          Statistics
        </a>
        <a
          href="/history"
          class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z" />
          </svg>
          History
        </a>
        <button
          onclick="document.getElementById('settingsModal').classList.toggle('hidden')"
          class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Settings
        </button>
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <div class="max-w-7xl mx-auto px-4 py-6 space-y-6">

    <!-- Statistics Row -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      
      <!-- Today's Study -->
      <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm">
        <div class="flex items-center gap-3 mb-2">
          <div class="bg-indigo-100 rounded-lg p-2">
            <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z" />
            </svg>
          </div>
          <span class="text-sm font-medium text-gray-600">Today's Study</span>
        </div>
        <div class="mb-2">
          <% const todayHours = Math.floor(todayTotal / 60); %>
          <% const todayMins = todayTotal % 60; %>
          <p class="text-2xl font-bold text-gray-800">
            <%= todayHours > 0 ? todayHours + 'h ' : '' %><%= todayMins + 'm' %>
          </p>
          <% const dgh = Math.floor(dailyGoal / 60); %>
          <p class="text-xs text-gray-500">Goal: <%= dgh %>h</p>
        </div>
        <div class="w-full bg-gray-100 rounded-full h-1.5">
          <div class="h-1.5 bg-indigo-500 rounded-full transition-all" style="width: <%= dailyProgress %>%"></div>
        </div>
      </div>

      <!-- This Week -->
      <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm">
        <div class="flex items-center gap-3 mb-2">
          <div class="bg-emerald-100 rounded-lg p-2">
            <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
            </svg>
          </div>
          <span class="text-sm font-medium text-gray-600">This Week</span>
        </div>
        <div>
          <%
            const wh = Math.floor(weeklyTotal / 60);
            const wm = weeklyTotal % 60;
          %>
          <p class="text-2xl font-bold text-gray-800">
            <%= wh > 0 ? wh + 'h ' : '' %><%= wm + 'm' %>
          </p>
          <p class="text-xs text-gray-500">Total study time</p>
        </div>
      </div>

      <!-- This Month -->
      <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm">
        <div class="flex items-center gap-3 mb-2">
          <div class="bg-sky-100 rounded-lg p-2">
            <svg class="w-5 h-5 text-sky-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
            </svg>
          </div>
          <span class="text-sm font-medium text-gray-600">This Month</span>
        </div>
        <div>
          <%
            const mh = Math.floor(monthlyTotal / 60);
            const mm = monthlyTotal % 60;
          %>
          <p class="text-2xl font-bold text-gray-800">
            <%= mh > 0 ? mh + 'h ' : '' %><%= mm + 'm' %>
          </p>
          <p class="text-xs text-gray-500"><%= monthlySessions %> <%= monthlySessions === 1 ? 'session' : 'sessions' %></p>
        </div>
      </div>

      <!-- Overall Total -->
      <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm">
        <div class="flex items-center gap-3 mb-2">
          <div class="bg-violet-100 rounded-lg p-2">
            <svg class="w-5 h-5 text-violet-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zm6.75-9.75C9.75 2.754 10.254 2.25 10.875 2.25h2.25c.621 0 1.125.504 1.125 1.125v16.5c0 .621-.504 1.125-1.125 1.125h-2.25A1.125 1.125 0 019.75 19.875V3.375zm6.75 4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.625c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.25z" />
            </svg>
          </div>
          <span class="text-sm font-medium text-gray-600">Overall Total</span>
        </div>
        <div>
          <% const totalHours = Math.floor(totalStudyTime / 60); %>
          <% const totalMins = totalStudyTime % 60; %>
          <p class="text-2xl font-bold text-gray-800">
            <%= totalHours > 0 ? totalHours + 'h ' : '' %><%= totalMins + 'm' %>
          </p>
          <p class="text-xs text-gray-500">All time</p>
        </div>
      </div>

      <!-- Study Streak -->
      <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm">
        <div class="flex items-center gap-3 mb-2">
          <div class="<%= currentStreak > 0 ? 'bg-orange-100' : 'bg-gray-100' %> rounded-lg p-2">
            <span class="text-2xl">🔥</span>
          </div>
          <span class="text-sm font-medium text-gray-600">Study Streak</span>
        </div>
        <div>
          <p class="text-2xl font-bold <%= currentStreak > 0 ? 'text-orange-600' : 'text-gray-400' %>">
            <%= currentStreak %> <%= currentStreak === 1 ? 'day' : 'days' %>
          </p>
          <p class="text-xs text-gray-500">
            <%= currentStreak > 0 ? 'Keep going!' : 'Reach your goal today' %>
          </p>
        </div>
      </div>

    </div>

    <!-- 3-Column Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- LEFT: Add Study Session Form -->
      <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-gray-700 mb-4">Add Study Session</h2>

        <%# ---- Validation error banner ---- %>
        <% if (typeof formErrors !== 'undefined' && formErrors.length > 0) { %>
          <div class="mb-4 rounded-lg border border-red-200 bg-red-50 p-3">
            <p class="text-xs font-semibold text-red-700 mb-1">Please fix the following:</p>
            <ul class="list-disc list-inside space-y-0.5">
              <% formErrors.forEach(e => { %>
                <li class="text-xs text-red-600"><%= e %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <form method="POST" action="/study" class="space-y-4" id="addSessionForm" onsubmit="return validateAddSessionForm(event)">
          <!-- Subject -->
          <div>
            <label for="subject" class="block text-sm font-medium text-gray-600 mb-1">Subject</label>
            <%
              const subjectVal   = (typeof formValues !== 'undefined' && formValues) ? formValues.subject : '';
              const subjectError = (typeof formErrors !== 'undefined') && formErrors.some(e => e.toLowerCase().includes('subject'));
            %>
            <input
              type="text"
              id="subject"
              name="subject"
              placeholder="e.g. Mathematics, History..."
              value="<%= subjectVal %>"
              required
              class="w-full border rounded-lg px-3 py-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:border-transparent transition
                     <%= subjectError ? 'border-red-400 bg-red-50 focus:ring-red-400' : 'border-gray-300 focus:ring-indigo-400' %>"
              oninput="clearValidationError('subject')"
            />
            <p id="subjectError" class="mt-1 text-xs text-red-500 hidden"></p>
            <% if (subjectError) { %>
              <p class="mt-1 text-xs text-red-500">Subject must be 2–50 characters.</p>
            <% } %>
          </div>

          <!-- Hours & Minutes -->
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="hours" class="block text-sm font-medium text-gray-600 mb-1">Hours</label>
              <%
                const hoursVal   = (typeof formValues !== 'undefined' && formValues) ? formValues.hours : '';
                const hoursError = (typeof formErrors !== 'undefined') && formErrors.some(e => e.toLowerCase().includes('hour'));
              %>
              <input
                type="number"
                id="hours"
                name="hours"
                min="0"
                max="23"
                placeholder="0"
                value="<%= hoursVal %>"
                class="w-full border rounded-lg px-3 py-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:border-transparent transition
                       <%= hoursError ? 'border-red-400 bg-red-50 focus:ring-red-400' : 'border-gray-300 focus:ring-indigo-400' %>"
                oninput="clearValidationError('hours')"
              />
              <p id="hoursError" class="mt-1 text-xs text-red-500 hidden"></p>
            </div>
            <div>
              <label for="minutes" class="block text-sm font-medium text-gray-600 mb-1">Minutes</label>
              <%
                const minutesVal   = (typeof formValues !== 'undefined' && formValues) ? formValues.minutes : '';
                const minutesError = (typeof formErrors !== 'undefined') && formErrors.some(e => e.toLowerCase().includes('minute'));
              %>
              <input
                type="number"
                id="minutes"
                name="minutes"
                min="0"
                max="59"
                placeholder="0"
                value="<%= minutesVal %>"
                class="w-full border rounded-lg px-3 py-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:border-transparent transition
                       <%= minutesError ? 'border-red-400 bg-red-50 focus:ring-red-400' : 'border-gray-300 focus:ring-indigo-400' %>"
                oninput="clearValidationError('minutes')"
              />
              <p id="minutesError" class="mt-1 text-xs text-red-500 hidden"></p>
            </div>
          </div>

          <!-- Duration Error (for when both hours and minutes are 0) -->
          <p id="durationError" class="text-xs text-red-500 hidden"></p>

          <!-- Submit -->
          <button
            type="submit"
            class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 rounded-lg text-sm transition">
            Add Study Session
          </button>
        </form>
      </div>

      <!-- MIDDLE: Study Timer -->
      <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-gray-700 mb-4">Study Timer</h2>

        <!-- Timer Display -->
        <div class="text-center mb-4">
          <div id="timerDisplay" class="text-5xl font-bold text-gray-800 font-mono tracking-tight mb-2">
            00:00:00
          </div>
          <p id="timerStatus" class="text-xs text-gray-500">Ready to start</p>
        </div>

        <!-- Subject Input for Timer -->
        <div class="mb-4">
          <label for="timerSubject" class="block text-sm font-medium text-gray-600 mb-1">Subject</label>
          <input
            type="text"
            id="timerSubject"
            placeholder="e.g. Mathematics, History..."
            class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent transition"
          />
          <p id="timerSubjectError" class="mt-1 text-xs text-red-500 hidden"></p>
        </div>

        <!-- Timer Control Buttons (Stable Layout - Always Visible) -->
        <div class="grid grid-cols-3 gap-2 mb-2">
          <button
            id="timerStartBtn"
            onclick="startTimer()"
            class="bg-emerald-600 hover:bg-emerald-700 disabled:bg-gray-300 disabled:cursor-not-allowed text-white font-medium py-2 rounded-lg text-sm transition flex items-center justify-center gap-1">
            <span>▶</span>
            <span>Start</span>
          </button>
          
          <button
            id="timerStopBtn"
            onclick="stopTimer()"
            disabled
            class="bg-red-600 hover:bg-red-700 disabled:bg-gray-300 disabled:cursor-not-allowed text-white font-medium py-2 rounded-lg text-sm transition flex items-center justify-center gap-1">
            <span>■</span>
            <span>Stop</span>
          </button>
          
          <button
            id="timerResetBtn"
            onclick="resetTimer()"
            class="bg-gray-500 hover:bg-gray-600 disabled:bg-gray-300 disabled:cursor-not-allowed text-white font-medium py-2 rounded-lg text-sm transition flex items-center justify-center gap-1">
            <span>↻</span>
            <span>Reset</span>
          </button>
        </div>

        <!-- Submit Button (Full Width) -->
        <button
          id="timerSubmitBtn"
          onclick="submitTimer()"
          disabled
          class="w-full bg-indigo-600 hover:bg-indigo-700 disabled:bg-gray-300 disabled:cursor-not-allowed text-white font-medium py-2.5 rounded-lg text-sm transition flex items-center justify-center gap-2">
          <span>✓</span>
          <span id="submitBtnText">Submit</span>
        </button>

        <!-- Info Message -->
        <p class="text-xs text-gray-500 text-center mt-3">
          ⓘ Time will be added only when you click Submit.
        </p>

        <!-- Timer Warning Message -->
        <div id="timerWarning" class="hidden mt-4 rounded-lg border border-amber-200 bg-amber-50 p-3">
          <p class="text-xs text-amber-800"></p>
        </div>
      </div>

      <!-- RIGHT: Study by Subject -->
      <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-gray-700 mb-4">Study by Subject</h2>
        
        <% if (subjectStats.length > 0) { %>
          <%
            // Find the highest study time for progress bar calculation
            const maxMinutes = subjectStats[0].totalMinutes;
          %>
          <div class="space-y-3">
            <% subjectStats.forEach(stat => { %>
              <%
                const statHours = Math.floor(stat.totalMinutes / 60);
                const statMins = stat.totalMinutes % 60;
                const statTimeStr = (statHours > 0 ? statHours + 'h ' : '') + statMins + 'm';
                const progressWidth = maxMinutes > 0 ? Math.round((stat.totalMinutes / maxMinutes) * 100) : 0;
              %>
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-sm font-medium text-gray-700"><%= stat.subject %></span>
                  <span class="text-sm font-semibold text-indigo-600"><%= statTimeStr %></span>
                </div>
                <div class="w-full bg-gray-100 rounded-full h-2 overflow-hidden">
                  <div
                    class="h-2 bg-indigo-500 rounded-full transition-all duration-500"
                    style="width: <%= progressWidth %>%">
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-8 text-gray-400">
            <svg class="w-12 h-12 mx-auto mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
            </svg>
            <p class="text-sm">No study data yet</p>
          </div>
        <% } %>
      </div>

    </div>

    <!-- Weekly Study Chart -->
    <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-gray-700 mb-4">Weekly Study Chart</h2>
      <div class="w-full h-64 sm:h-80">
        <canvas id="weeklyChart"></canvas>
      </div>
    </div>

    <!-- Monthly Study Chart -->
    <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-gray-700 mb-4">Monthly Study Chart</h2>
      <div class="w-full h-64 sm:h-80">
        <canvas id="monthlyChart"></canvas>
      </div>
    </div>

    <!-- Study History -->
    <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-gray-700 mb-4">Study History</h2>

      <% if (groupedSessions.length === 0) { %>
        <!-- Empty state -->
        <div class="text-center py-12 text-gray-400">
          <svg class="w-14 h-14 mx-auto mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z" />
          </svg>
          <p class="text-base">No study sessions yet</p>
          <p class="text-sm mt-1">Add your first session above</p>
        </div>
      <% } else { %>
        <div class="space-y-4">
          <% groupedSessions.forEach(group => { %>
            <%
              const dh = Math.floor(group.total / 60);
              const dm = group.total % 60;
              const dailyTotalStr = (dh > 0 ? dh + 'h ' : '') + dm + 'm';
            %>
            <div class="border border-gray-200 rounded-lg overflow-hidden">

              <!-- Date header -->
              <div class="flex items-center justify-between px-4 py-2.5 bg-gray-50 border-b border-gray-200">
                <span class="text-sm font-semibold text-gray-700"><%= group.label %></span>
                <span class="text-xs font-medium text-indigo-600 bg-indigo-50 px-2 py-1 rounded">
                  Total: <%= dailyTotalStr %>
                </span>
              </div>

              <!-- Sessions for this day -->
              <div class="divide-y divide-gray-100">
                <% group.sessions.forEach(session => { %>
                  <%
                    const h = Math.floor(session.duration / 60);
                    const m = session.duration % 60;
                    const durationStr = (h > 0 ? h + 'h ' : '') + m + 'm';
                  %>
                  <div class="px-4 py-3 flex items-center justify-between gap-4 hover:bg-gray-50 transition">
                    <div class="flex items-center gap-3 min-w-0 flex-1">
                      <div class="bg-indigo-100 text-indigo-600 rounded-lg p-2 shrink-0">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                        </svg>
                      </div>
                      <p class="text-sm font-medium text-gray-700 truncate"><%= session.subject %></p>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                      <span class="text-sm font-medium text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded">
                        <%= durationStr %>
                      </span>
                      <a
                        href="/study/<%= session._id %>/edit"
                        class="text-xs text-gray-600 hover:text-indigo-600 hover:bg-indigo-50 border border-gray-300 hover:border-indigo-300 px-2 py-1 rounded transition">
                        Edit
                      </a>
                      <form method="POST" action="/study/<%= session._id %>?_method=DELETE" class="inline">
                        <button
                          type="submit"
                          onclick="return confirm('Delete this session?')"
                          class="text-xs text-gray-600 hover:text-red-600 hover:bg-red-50 border border-gray-300 hover:border-red-300 px-2 py-1 rounded transition">
                          Delete
                        </button>
                      </form>
                    </div>
                  </div>
                <% }) %>
              </div>

            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

  </div>

  <!-- Settings Modal -->
  <div id="settingsModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-lg shadow-xl max-w-md w-full p-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-semibold text-gray-700">Settings</h2>
        <button
          onclick="document.getElementById('settingsModal').classList.add('hidden')"
          class="text-gray-400 hover:text-gray-600 transition">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form method="POST" action="/settings">
        <div class="mb-4">
          <label for="dailyGoalHours" class="block text-sm font-medium text-gray-600 mb-2">
            Daily Study Goal (hours)
          </label>
          <input
            type="number"
            id="dailyGoalHours"
            name="dailyGoalHours"
            min="0.5"
            max="24"
            step="0.5"
            value="<%= dailyGoalHours %>"
            class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent transition"
          />
          <p class="text-xs text-gray-500 mt-2">Current goal: <%= dailyGoalHours %>h per day</p>
        </div>
        <button
          type="submit"
          class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 rounded-lg text-sm transition">
          Save Settings
        </button>
      </form>
    </div>
  </div>

  <!-- Footer -->
  <footer class="text-center py-6 text-gray-400 text-sm">
    Study Time Tracker &copy; <%= new Date().getFullYear() %>
  </footer>

  <!-- Chart.js Initialization -->
  <script>
    // Client-side validation for Add Session form
    function validateAddSessionForm(event) {
      let isValid = true;
      
      // Clear all previous errors
      clearAllValidationErrors();
      
      // Get form values
      const subject = document.getElementById('subject').value.trim();
      const hours = parseInt(document.getElementById('hours').value) || 0;
      const minutes = parseInt(document.getElementById('minutes').value) || 0;
      
      // Validate subject
      if (!subject) {
        showValidationError('subject', 'Subject cannot be empty.');
        isValid = false;
      } else if (subject.length < 2 || subject.length > 50) {
        showValidationError('subject', 'Subject must be between 2 and 50 characters.');
        isValid = false;
      }
      
      // Validate hours
      if (hours < 0) {
        showValidationError('hours', 'Hours cannot be negative.');
        isValid = false;
      } else if (hours > 23) {
        showValidationError('hours', 'Hours cannot exceed 23.');
        isValid = false;
      }
      
      // Validate minutes
      if (minutes < 0) {
        showValidationError('minutes', 'Minutes cannot be negative.');
        isValid = false;
      } else if (minutes > 59) {
        showValidationError('minutes', 'Minutes must be between 0 and 59.');
        isValid = false;
      }
      
      // Validate total duration
      if (hours === 0 && minutes === 0) {
        showValidationError('duration', 'Study duration must be greater than 0.');
        isValid = false;
      }
      
      if (!isValid) {
        event.preventDefault();
        return false;
      }
      
      return true;
    }
    
    function showValidationError(fieldId, message) {
      const errorElement = document.getElementById(fieldId + 'Error');
      const inputElement = document.getElementById(fieldId === 'duration' ? 'hours' : fieldId);
      
      if (errorElement) {
        errorElement.textContent = message;
        errorElement.classList.remove('hidden');
      }
      
      if (inputElement) {
        inputElement.classList.remove('border-gray-300', 'focus:ring-indigo-400');
        inputElement.classList.add('border-red-400', 'bg-red-50', 'focus:ring-red-400');
      }
      
      // For duration error, also highlight minutes field
      if (fieldId === 'duration') {
        const minutesElement = document.getElementById('minutes');
        if (minutesElement) {
          minutesElement.classList.remove('border-gray-300', 'focus:ring-indigo-400');
          minutesElement.classList.add('border-red-400', 'bg-red-50', 'focus:ring-red-400');
        }
      }
    }
    
    function clearValidationError(fieldId) {
      const errorElement = document.getElementById(fieldId + 'Error');
      const inputElement = document.getElementById(fieldId);
      
      if (errorElement) {
        errorElement.classList.add('hidden');
      }
      
      if (inputElement) {
        inputElement.classList.remove('border-red-400', 'bg-red-50', 'focus:ring-red-400');
        inputElement.classList.add('border-gray-300', 'focus:ring-indigo-400');
      }
      
      // Also clear duration error when hours or minutes change
      if (fieldId === 'hours' || fieldId === 'minutes') {
        const durationError = document.getElementById('durationError');
        if (durationError) {
          durationError.classList.add('hidden');
        }
        // Reset both fields' styling if they were marked as error for duration
        ['hours', 'minutes'].forEach(id => {
          const element = document.getElementById(id);
          if (element && element.classList.contains('border-red-400')) {
            element.classList.remove('border-red-400', 'bg-red-50', 'focus:ring-red-400');
            element.classList.add('border-gray-300', 'focus:ring-indigo-400');
          }
        });
      }
    }
    
    function clearAllValidationErrors() {
      ['subject', 'hours', 'minutes', 'duration'].forEach(clearValidationError);
    }

    // Weekly Chart
    const weeklyCtx = document.getElementById('weeklyChart').getContext('2d');
    const weeklyChart = new Chart(weeklyCtx, {
      type: 'bar',
      data: {
        labels: <%- JSON.stringify(weeklyChartLabels) %>,
        datasets: [{
          label: 'Study Hours',
          data: <%- JSON.stringify(weeklyChartData) %>,
          backgroundColor: 'rgba(99, 102, 241, 0.8)',
          borderColor: 'rgba(99, 102, 241, 1)',
          borderWidth: 1,
          borderRadius: 6,
          maxBarThickness: 60
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                return context.parsed.y + ' hours';
              }
            }
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              callback: function(value) {
                return value + 'h';
              }
            },
            grid: {
              color: 'rgba(0, 0, 0, 0.05)'
            }
          },
          x: {
            grid: {
              display: false
            }
          }
        }
      }
    });

    // Monthly Chart
    const monthlyCtx = document.getElementById('monthlyChart').getContext('2d');
    const monthlyChart = new Chart(monthlyCtx, {
      type: 'line',
      data: {
        labels: <%- JSON.stringify(monthlyChartLabels) %>,
        datasets: [{
          label: 'Study Hours',
          data: <%- JSON.stringify(monthlyChartData) %>,
          backgroundColor: 'rgba(16, 185, 129, 0.1)',
          borderColor: 'rgba(16, 185, 129, 1)',
          borderWidth: 2,
          fill: true,
          tension: 0.4,
          pointRadius: 3,
          pointHoverRadius: 5,
          pointBackgroundColor: 'rgba(16, 185, 129, 1)',
          pointBorderColor: '#fff',
          pointBorderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                return context.parsed.y + ' hours';
              }
            }
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              callback: function(value) {
                return value + 'h';
              }
            },
            grid: {
              color: 'rgba(0, 0, 0, 0.05)'
            }
          },
          x: {
            grid: {
              display: false
            },
            ticks: {
              maxRotation: 0,
              autoSkip: true,
              maxTicksLimit: 15
            }
          }
        }
      }
    });

    // ==========================================================================
    // STUDY TIMER IMPLEMENTATION
    // ==========================================================================

    /**
     * Timer State (persisted in localStorage for cross-navigation persistence)
     * - timerState: 'ready' | 'running' | 'stopped'
     * - timerSubject: string
     * - timerStartTime: timestamp (when timer was started)
     * - timerElapsedSeconds: exact accumulated seconds
     */

    let timerState = 'ready';
    let timerSubject = '';
    let timerStartTime = null;
    let timerElapsedSeconds = 0;
    let timerIntervalId = null;

    const TIMER_STORAGE_KEY = 'studyTimerState';

    // DOM Elements
    const timerDisplay = document.getElementById('timerDisplay');
    const timerStatus = document.getElementById('timerStatus');
    const timerSubjectInput = document.getElementById('timerSubject');
    const timerSubjectError = document.getElementById('timerSubjectError');
    const timerWarning = document.getElementById('timerWarning');
    const startBtn = document.getElementById('timerStartBtn');
    const stopBtn = document.getElementById('timerStopBtn');
    const resetBtn = document.getElementById('timerResetBtn');
    const submitBtn = document.getElementById('timerSubmitBtn');
    const submitBtnText = document.getElementById('submitBtnText');

    /**
     * Initialize timer on page load — restore from localStorage if exists
     */
    function initTimer() {
      const saved = localStorage.getItem(TIMER_STORAGE_KEY);
      if (saved) {
        try {
          const state = JSON.parse(saved);
          timerState = state.timerState || 'ready';
          timerSubject = state.timerSubject || '';
          timerStartTime = state.timerStartTime || null;
          timerElapsedSeconds = state.timerElapsedSeconds || 0;

          // Populate subject input
          timerSubjectInput.value = timerSubject;

          // If timer was running, continue it
          if (timerState === 'running' && timerStartTime) {
            // Recalculate elapsed time based on current time
            const now = Date.now();
            const additionalSeconds = Math.floor((now - timerStartTime) / 1000);
            timerElapsedSeconds += additionalSeconds;
            timerStartTime = now; // Reset to now
            startTimerTick();
            updateUI();
          } else if (timerState === 'stopped') {
            updateDisplay();
            updateUI();
          }
        } catch (err) {
          console.error('Failed to restore timer state:', err);
          clearAndResetTimer();
        }
      }
    }

    /**
     * Save timer state to localStorage
     */
    function saveTimerState() {
      const state = {
        timerState,
        timerSubject,
        timerStartTime,
        timerElapsedSeconds
      };
      localStorage.setItem(TIMER_STORAGE_KEY, JSON.stringify(state));
    }

    /**
     * Clear timer state from localStorage
     */
    function clearTimerState() {
      localStorage.removeItem(TIMER_STORAGE_KEY);
    }

    /**
     * Format seconds as HH:MM:SS
     */
    function formatTime(totalSeconds) {
      const hours = Math.floor(totalSeconds / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;
      return [hours, minutes, seconds]
        .map(v => String(v).padStart(2, '0'))
        .join(':');
    }

    /**
     * Format seconds as human readable (e.g., "3m 15s", "45s", "1h 5m 30s")
     */
    function formatTimeHuman(totalSeconds) {
      const hours = Math.floor(totalSeconds / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;
      
      const parts = [];
      if (hours > 0) parts.push(`${hours}h`);
      if (minutes > 0) parts.push(`${minutes}m`);
      if (seconds > 0 || parts.length === 0) parts.push(`${seconds}s`);
      
      return parts.join(' ');
    }

    /**
     * Update the timer display with current elapsed time
     */
    function updateDisplay() {
      let currentElapsed = timerElapsedSeconds;
      if (timerState === 'running' && timerStartTime) {
        const now = Date.now();
        const additionalSeconds = Math.floor((now - timerStartTime) / 1000);
        currentElapsed += additionalSeconds;
      }
      timerDisplay.textContent = formatTime(currentElapsed);
    }

    /**
     * Update UI button states and status text
     * Buttons always remain visible - only enabled/disabled state changes
     */
    function updateUI() {
      // Clear any previous warnings
      hideWarning();
      clearSubjectError();

      if (timerState === 'ready') {
        timerStatus.textContent = 'Ready to start';
        timerStatus.className = 'text-xs text-gray-500';
        
        startBtn.disabled = false;
        stopBtn.disabled = true;
        resetBtn.disabled = false;
        submitBtn.disabled = true;
        submitBtnText.textContent = 'Submit';
        
        timerSubjectInput.disabled = false;
      } else if (timerState === 'running') {
        timerStatus.textContent = 'Running ●';
        timerStatus.className = 'text-xs text-emerald-600 font-medium';
        
        startBtn.disabled = true;
        stopBtn.disabled = false;
        resetBtn.disabled = false;
        submitBtn.disabled = true;
        submitBtnText.textContent = 'Submit';
        
        timerSubjectInput.disabled = true;
      } else if (timerState === 'stopped') {
        timerStatus.textContent = 'Stopped';
        timerStatus.className = 'text-xs text-amber-600 font-medium';
        
        startBtn.disabled = true;
        stopBtn.disabled = true;
        resetBtn.disabled = false;
        submitBtn.disabled = false;
        
        // Show exact time that will be added
        const timeStr = formatTimeHuman(timerElapsedSeconds);
        submitBtnText.textContent = `Submit (Add ${timeStr})`;
        
        timerSubjectInput.disabled = false; // Allow editing subject before submit
      }
    }

    /**
     * Show warning message
     */
    function showWarning(message) {
      timerWarning.querySelector('p').textContent = message;
      timerWarning.classList.remove('hidden');
    }

    /**
     * Hide warning message
     */
    function hideWarning() {
      timerWarning.classList.add('hidden');
    }

    /**
     * Show subject input error
     */
    function showSubjectError(message) {
      timerSubjectError.textContent = message;
      timerSubjectError.classList.remove('hidden');
      timerSubjectInput.classList.remove('border-gray-300', 'focus:ring-indigo-400');
      timerSubjectInput.classList.add('border-red-400', 'bg-red-50', 'focus:ring-red-400');
    }

    /**
     * Clear subject input error
     */
    function clearSubjectError() {
      timerSubjectError.classList.add('hidden');
      timerSubjectInput.classList.remove('border-red-400', 'bg-red-50', 'focus:ring-red-400');
      timerSubjectInput.classList.add('border-gray-300', 'focus:ring-indigo-400');
    }

    /**
     * Start the interval timer tick (every 100ms for smooth updates)
     */
    function startTimerTick() {
      if (timerIntervalId) clearInterval(timerIntervalId);
      timerIntervalId = setInterval(() => {
        updateDisplay();
        saveTimerState();
      }, 100);
    }

    /**
     * Stop the interval timer tick
     */
    function stopTimerTick() {
      if (timerIntervalId) {
        clearInterval(timerIntervalId);
        timerIntervalId = null;
      }
    }

    /**
     * START button handler
     * Validates subject and starts the timer running
     * Does NOT save to database
     */
    function startTimer() {
      // Validate subject
      const subject = timerSubjectInput.value.trim();
      if (!subject) {
        showSubjectError('Subject is required.');
        return;
      }
      if (subject.length < 2) {
        showSubjectError('Subject must be at least 2 characters.');
        return;
      }
      if (subject.length > 50) {
        showSubjectError('Subject must be 50 characters or fewer.');
        return;
      }

      // Start timer
      timerState = 'running';
      timerSubject = subject;
      timerStartTime = Date.now();
      timerElapsedSeconds = 0;

      startTimerTick();
      updateUI();
      saveTimerState();
    }

    /**
     * STOP button handler
     * Stops/freezes the timer WITHOUT saving to database
     * Preserves exact elapsed seconds
     */
    function stopTimer() {
      if (timerState !== 'running') return;

      // Calculate and freeze exact elapsed time
      const now = Date.now();
      const additionalSeconds = Math.floor((now - timerStartTime) / 1000);
      timerElapsedSeconds += additionalSeconds;

      timerState = 'stopped';
      timerStartTime = null;

      stopTimerTick();
      updateDisplay();
      updateUI();
      saveTimerState();
    }

    /**
     * RESET button handler
     * Resets timer back to 00:00:00 WITHOUT saving to database
     * If timer is running, asks for confirmation first
     */
    function resetTimer() {
      // If running, ask for confirmation
      if (timerState === 'running') {
        if (!confirm('Reset the running timer? Your current time will be lost.')) {
          return;
        }
      }

      // Clear and reset everything
      clearAndResetTimer();
    }

    /**
     * Clear all timer data and reset to initial state
     */
    function clearAndResetTimer() {
      timerState = 'ready';
      timerSubject = '';
      timerStartTime = null;
      timerElapsedSeconds = 0;

      stopTimerTick();
      clearTimerState();
      timerSubjectInput.value = '';
      timerDisplay.textContent = '00:00:00';
      updateUI();
    }

    /**
     * SUBMIT button handler
     * This is the ONLY function that saves to MongoDB
     * Saves exact durationSeconds to database
     */
    async function submitTimer() {
      if (timerState !== 'stopped') {
        showWarning('Please stop the timer before submitting.');
        return;
      }

      // Re-validate subject (user might have changed it)
      const subject = timerSubjectInput.value.trim();
      if (!subject) {
        showSubjectError('Subject is required.');
        return;
      }
      if (subject.length < 2) {
        showSubjectError('Subject must be at least 2 characters.');
        return;
      }
      if (subject.length > 50) {
        showSubjectError('Subject must be 50 characters or fewer.');
        return;
      }

      // Validate minimum time (at least 1 second)
      const finalElapsed = timerElapsedSeconds;
      if (finalElapsed < 1) {
        showWarning('Timer must run for at least 1 second before submitting.');
        return;
      }

      // Disable the submit button to prevent double-clicks
      submitBtn.disabled = true;
      submitBtnText.textContent = 'Saving...';

      try {
        // Send to server - ONLY time we save to database
        // Send exact seconds - server will store durationSeconds and derive duration (minutes)
        const response = await fetch('/timer/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            subject: subject, // Use current subject value (might have been edited)
            elapsedSeconds: finalElapsed
          })
        });

        const result = await response.json();

        if (response.ok && result.success) {
          // Success — reset timer and reload page to show new session
          clearAndResetTimer();
          window.location.reload();
        } else {
          // Server returned an error
          showWarning(result.error || 'Failed to save session. Please try again.');
          submitBtn.disabled = false;
          const timeStr = formatTimeHuman(finalElapsed);
          submitBtnText.textContent = `Submit (Add ${timeStr})`;
        }
      } catch (err) {
        console.error('Failed to save timer session:', err);
        showWarning('Network error. Please check your connection and try again.');
        submitBtn.disabled = false;
        const timeStr = formatTimeHuman(finalElapsed);
        submitBtnText.textContent = `Submit (Add ${timeStr})`;
      }
    }

    // Clear subject error when user types
    timerSubjectInput.addEventListener('input', clearSubjectError);

    // Initialize timer on page load
    initTimer();

    // ==========================================================================
    // ELECTRON IPC INTEGRATION
    // ==========================================================================
    
    /**
     * Integrate with Electron's shared timer state if running in Electron
     */
    if (window.electronAPI) {
      // Listen for timer state updates from Electron
      window.electronAPI.onTimerState((state) => {
        // Sync local state with Electron's shared state
        timerState = state.state;
        timerSubject = state.subject;
        timerStartTime = state.startTime;
        timerElapsedSeconds = state.elapsedSeconds;
        
        // Handle pause state
        if (state.isPaused && timerState === 'running') {
          // Timer is paused - show as stopped in main UI
          // (main UI doesn't have pause, so we show stopped state)
          timerState = 'stopped';
        }
        
        updateDisplay();
        updateUI();
        saveTimerState();
      });
      
      // Override timer functions to use Electron IPC
      const originalStartTimer = window.startTimer;
      window.startTimer = function() {
        // Validate subject locally first
        const subject = timerSubjectInput.value.trim();
        if (!subject) {
          showSubjectError('Subject is required.');
          return;
        }
        if (subject.length < 2) {
          showSubjectError('Subject must be at least 2 characters.');
          return;
        }
        if (subject.length > 50) {
          showSubjectError('Subject must be 50 characters or fewer.');
          return;
        }
        
        // Send to Electron
        window.electronAPI.sendTimerAction('start', { subject });
      };
      
      const originalStopTimer = window.stopTimer;
      window.stopTimer = function() {
        window.electronAPI.sendTimerAction('stop');
      };
      
      const originalResetTimer = window.clearAndResetTimer;
      window.clearAndResetTimer = function() {
        window.electronAPI.sendTimerAction('reset');
      };
      
      // Request initial state from Electron
      window.electronAPI.requestTimerState();
      
      // Handle save requests from floating widget (via Electron main process)
      window.electronAPI.onSaveTimerSession(async (data) => {
        const { subject, elapsedSeconds } = data;
        
        try {
          const response = await fetch('/timer/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ subject, elapsedSeconds })
          });
          
          if (response.ok) {
            // Refresh dashboard to show new session
            location.reload();
          } else {
            const errorData = await response.json();
            console.error('Failed to save timer session:', errorData.error);
            alert('Failed to save study session: ' + errorData.error);
          }
        } catch (error) {
          console.error('Error saving timer session:', error);
          alert('Error saving study session. Please try again.');
        }
      });
      
      // Sync local changes to Electron
      const originalSaveTimerState = saveTimerState;
      saveTimerState = function() {
        originalSaveTimerState();
        
        // Also update Electron's shared state
        if (window.electronAPI) {
          window.electronAPI.sendTimerAction('update-state', {
            state: timerState,
            subject: timerSubject,
            startTime: timerStartTime,
            elapsedSeconds: timerElapsedSeconds,
            isPaused: false
          });
        }
      };
    }

    // ==========================================================================
    // END ELECTRON IPC INTEGRATION
    // ==========================================================================

    // ==========================================================================
    // END TIMER IMPLEMENTATION
    // ==========================================================================
  </script>

</body>
</html>
