<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>History - Study Time Tracker</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    // Theme initialization — runs before page renders to prevent flash
    (function() {
      const theme = localStorage.getItem('theme') ||
                   (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      }
    })();

    // Configure Tailwind dark mode
    tailwind.config = {
      darkMode: 'class',
    };
  </script>
  <style>
    /* Scrollbar dark mode */
    .dark ::-webkit-scrollbar { width: 6px; }
    .dark ::-webkit-scrollbar-track { background: #1f2937; }
    .dark ::-webkit-scrollbar-thumb { background: #4b5563; border-radius: 3px; }
    .dark ::-webkit-scrollbar-thumb:hover { background: #6b7280; }

    /* Custom date input dark mode */
    .dark input[type="date"]::-webkit-calendar-picker-indicator {
      filter: invert(1);
    }
  </style>
</head>
<body class="bg-gray-50 dark:bg-gray-900 min-h-screen transition-colors duration-200">

  <!-- Header -->
  <header class="bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 sticky top-0 z-10 transition-colors duration-200">
    <div class="max-w-7xl mx-auto px-4 py-4">
      <div class="flex items-center justify-between mb-3">
        <div>
          <h1 class="text-2xl font-bold text-indigo-600 dark:text-indigo-400">Study History</h1>
          <p class="text-xs text-gray-500 dark:text-gray-400">View and analyze your study sessions</p>
        </div>
        <div class="flex items-center gap-2">
          <!-- Theme Toggle -->
          <button
            id="themeToggle"
            onclick="toggleTheme()"
            class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 rounded-lg transition"
            title="Toggle theme">
            <!-- Sun icon (shown in dark mode) -->
            <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <!-- Moon icon (shown in light mode) -->
            <svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
            <span class="hidden sm:inline">
              <span class="dark:hidden">Dark</span>
              <span class="hidden dark:inline">Light</span>
            </span>
          </button>

          <!-- Back to Dashboard -->
          <a href="/" class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 rounded-lg transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Dashboard
          </a>
        </div>
      </div>

      <!-- Period Filters -->
      <div class="flex flex-wrap gap-2">
        <a href="/history?period=today"
           class="px-3 py-1.5 text-xs font-medium rounded-lg transition <%= period === 'today' ? 'bg-indigo-600 text-white' : 'bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-200 border border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-600' %>">
          Today
        </a>
        <a href="/history?period=yesterday"
           class="px-3 py-1.5 text-xs font-medium rounded-lg transition <%= period === 'yesterday' ? 'bg-indigo-600 text-white' : 'bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-200 border border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-600' %>">
          Yesterday
        </a>
        <a href="/history?period=this-week"
           class="px-3 py-1.5 text-xs font-medium rounded-lg transition <%= period === 'this-week' ? 'bg-indigo-600 text-white' : 'bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-200 border border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-600' %>">
          This Week
        </a>
        <a href="/history?period=last-week"
           class="px-3 py-1.5 text-xs font-medium rounded-lg transition <%= period === 'last-week' ? 'bg-indigo-600 text-white' : 'bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-200 border border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-600' %>">
          Last Week
        </a>
        <a href="/history?period=this-month"
           class="px-3 py-1.5 text-xs font-medium rounded-lg transition <%= period === 'this-month' ? 'bg-indigo-600 text-white' : 'bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-200 border border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-600' %>">
          This Month
        </a>
        <a href="/history?period=last-month"
           class="px-3 py-1.5 text-xs font-medium rounded-lg transition <%= period === 'last-month' ? 'bg-indigo-600 text-white' : 'bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-200 border border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-600' %>">
          Last Month
        </a>
        <a href="/history?period=all-time"
           class="px-3 py-1.5 text-xs font-medium rounded-lg transition <%= period === 'all-time' ? 'bg-indigo-600 text-white' : 'bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-200 border border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-600' %>">
          All Time
        </a>
        <button
           onclick="document.getElementById('customRangeModal').classList.remove('hidden')"
           class="px-3 py-1.5 text-xs font-medium rounded-lg transition <%= period === 'custom' ? 'bg-indigo-600 text-white' : 'bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-200 border border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-600' %>">
          Custom Range
        </button>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-4 py-6 space-y-6">

    <!-- Period Label -->
    <div class="text-center">
      <h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100"><%= periodLabel %></h2>
    </div>

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">

      <!-- Total Study Time -->
      <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-5 shadow-sm transition-colors duration-200">
        <div class="flex items-center gap-3 mb-2">
          <div class="bg-indigo-100 dark:bg-indigo-900 rounded-lg p-2">
            <svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z" />
            </svg>
          </div>
          <span class="text-sm font-medium text-gray-600 dark:text-gray-300">Total Study Time</span>
        </div>
        <div>
          <% const totalHours = Math.floor(totalStudyTime / 60); %>
          <% const totalMins = totalStudyTime % 60; %>
          <p class="text-2xl font-bold text-gray-800 dark:text-gray-100">
            <%= totalHours > 0 ? totalHours + 'h ' : '' %><%= totalMins + 'm' %>
          </p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1"><%= totalStudyTime %> minutes</p>
        </div>
      </div>

      <!-- Number of Sessions -->
      <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-5 shadow-sm transition-colors duration-200">
        <div class="flex items-center gap-3 mb-2">
          <div class="bg-emerald-100 dark:bg-emerald-900 rounded-lg p-2">
            <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <span class="text-sm font-medium text-gray-600 dark:text-gray-300">Sessions</span>
        </div>
        <div>
          <p class="text-2xl font-bold text-gray-800 dark:text-gray-100"><%= numberOfSessions %></p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1"><%= numberOfSessions === 1 ? 'session' : 'sessions' %> recorded</p>
        </div>
      </div>

      <!-- Average per Session -->
      <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-5 shadow-sm transition-colors duration-200">
        <div class="flex items-center gap-3 mb-2">
          <div class="bg-violet-100 dark:bg-violet-900 rounded-lg p-2">
            <svg class="w-5 h-5 text-violet-600 dark:text-violet-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <span class="text-sm font-medium text-gray-600 dark:text-gray-300">Average per Session</span>
        </div>
        <div>
          <% const avgMins = numberOfSessions > 0 ? Math.round(totalStudyTime / numberOfSessions) : 0; %>
          <% const avgHours = Math.floor(avgMins / 60); %>
          <% const avgMinutes = avgMins % 60; %>
          <p class="text-2xl font-bold text-gray-800 dark:text-gray-100">
            <%= avgHours > 0 ? avgHours + 'h ' : '' %><%= avgMinutes + 'm' %>
          </p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">per session</p>
        </div>
      </div>

    </div>

    <!-- 2-Column Layout: Subject Stats & Daily Totals -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

      <!-- Study by Subject -->
      <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-6 shadow-sm transition-colors duration-200">
        <h2 class="text-lg font-semibold text-gray-700 dark:text-gray-200 mb-4">Study by Subject</h2>

        <% if (subjectStats.length > 0) { %>
          <%
            const maxMinutes = subjectStats[0].totalMinutes;
          %>
          <div class="space-y-3">
            <% subjectStats.forEach(stat => { %>
              <%
                const statHours = Math.floor(stat.totalMinutes / 60);
                const statMins = stat.totalMinutes % 60;
                const statTimeStr = (statHours > 0 ? statHours + 'h ' : '') + statMins + 'm';
                const progressWidth = maxMinutes > 0 ? Math.round((stat.totalMinutes / maxMinutes) * 100) : 0;
              %>
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-sm font-medium text-gray-700 dark:text-gray-200"><%= stat.subject %></span>
                  <span class="text-sm font-semibold text-indigo-600 dark:text-indigo-400"><%= statTimeStr %></span>
                </div>
                <div class="w-full bg-gray-100 dark:bg-gray-700 rounded-full h-2 overflow-hidden">
                  <div
                    class="h-2 bg-indigo-500 dark:bg-indigo-400 rounded-full transition-all duration-500"
                    style="width: <%= progressWidth %>%">
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-8 text-gray-400 dark:text-gray-500">
            <svg class="w-12 h-12 mx-auto mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
            </svg>
            <p class="text-sm">No study data for this period</p>
          </div>
        <% } %>
      </div>

      <!-- Daily Totals -->
      <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-6 shadow-sm transition-colors duration-200">
        <h2 class="text-lg font-semibold text-gray-700 dark:text-gray-200 mb-4">Daily Totals</h2>

        <% if (dailyTotals.length > 0) { %>
          <div class="space-y-2 max-h-80 overflow-y-auto pr-1">
            <% dailyTotals.forEach(day => { %>
              <%
                const dayHours = Math.floor(day.minutes / 60);
                const dayMins = day.minutes % 60;
                const dayTimeStr = (dayHours > 0 ? dayHours + 'h ' : '') + dayMins + 'm';
                const formattedDate = new Date(day.date + 'T00:00:00').toLocaleDateString('en-US', {
                  weekday: 'short',
                  month: 'short',
                  day: 'numeric'
                });
              %>
              <div class="flex items-center justify-between p-2 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-lg transition">
                <span class="text-sm text-gray-700 dark:text-gray-200"><%= formattedDate %></span>
                <span class="text-sm font-semibold text-indigo-600 dark:text-indigo-400"><%= dayTimeStr %></span>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-8 text-gray-400 dark:text-gray-500">
            <svg class="w-12 h-12 mx-auto mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
            </svg>
            <p class="text-sm">No study data for this period</p>
          </div>
        <% } %>
      </div>

    </div>

    <!-- Study Sessions -->
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-6 shadow-sm transition-colors duration-200">
      <h2 class="text-lg font-semibold text-gray-700 dark:text-gray-200 mb-4">Study Sessions (<%= numberOfSessions %>)</h2>

      <% if (groupedSessions.length === 0) { %>
        <!-- Empty state -->
        <div class="text-center py-12 text-gray-400 dark:text-gray-500">
          <svg class="w-14 h-14 mx-auto mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z" />
          </svg>
          <p class="text-base">No sessions found</p>
          <p class="text-sm mt-1">Try selecting a different period</p>
        </div>
      <% } else { %>
        <div class="space-y-4">
          <% groupedSessions.forEach(group => { %>
            <%
              const dh = Math.floor(group.total / 60);
              const dm = group.total % 60;
              const dailyTotalStr = (dh > 0 ? dh + 'h ' : '') + dm + 'm';
            %>
            <div class="border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">

              <!-- Date header -->
              <div class="flex items-center justify-between px-4 py-2.5 bg-gray-50 dark:bg-gray-700 border-b border-gray-200 dark:border-gray-600">
                <span class="text-sm font-semibold text-gray-700 dark:text-gray-200"><%= group.label %></span>
                <span class="text-xs font-medium text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-900/40 px-2 py-1 rounded">
                  Total: <%= dailyTotalStr %>
                </span>
              </div>

              <!-- Sessions for this day -->
              <div class="divide-y divide-gray-100 dark:divide-gray-700">
                <% group.sessions.forEach(session => { %>
                  <%
                    const h = Math.floor(session.duration / 60);
                    const m = session.duration % 60;
                    const durationStr = (h > 0 ? h + 'h ' : '') + m + 'm';
                  %>
                  <div class="px-4 py-3 flex items-center justify-between gap-4 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition">
                    <div class="flex items-center gap-3 min-w-0 flex-1">
                      <div class="bg-indigo-100 dark:bg-indigo-900/50 text-indigo-600 dark:text-indigo-400 rounded-lg p-2 shrink-0">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                        </svg>
                      </div>
                      <p class="text-sm font-medium text-gray-700 dark:text-gray-200 truncate"><%= session.subject %></p>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                      <span class="text-sm font-medium text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-900/40 px-2.5 py-1 rounded">
                        <%= durationStr %>
                      </span>
                      <a
                        href="/study/<%= session._id %>/edit"
                        class="text-xs text-gray-600 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 border border-gray-300 dark:border-gray-600 hover:border-indigo-300 dark:hover:border-indigo-500 px-2 py-1 rounded transition">
                        Edit
                      </a>
                      <form method="POST" action="/study/<%= session._id %>?_method=DELETE" class="inline">
                        <button
                          type="submit"
                          onclick="return confirm('Delete this session?')"
                          class="text-xs text-gray-600 dark:text-gray-300 hover:text-red-600 dark:hover:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/30 border border-gray-300 dark:border-gray-600 hover:border-red-300 dark:hover:border-red-500 px-2 py-1 rounded transition">
                          Delete
                        </button>
                      </form>
                    </div>
                  </div>
                <% }) %>
              </div>

            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

  </div>

  <!-- Custom Date Range Modal -->
  <div id="customRangeModal" class="hidden fixed inset-0 bg-black bg-opacity-50 dark:bg-opacity-70 z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl max-w-md w-full p-6 transition-colors duration-200">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-semibold text-gray-700 dark:text-gray-200">Custom Date Range</h2>
        <button
          onclick="document.getElementById('customRangeModal').classList.add('hidden')"
          class="text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300 transition">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form method="GET" action="/history">
        <input type="hidden" name="period" value="custom" />

        <div class="mb-4">
          <label for="startDate" class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-2">
            Start Date
          </label>
          <input
            type="date"
            id="startDate"
            name="startDate"
            value="<%= startDate %>"
            required
            class="w-full border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg px-3 py-2 text-sm text-gray-700 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent transition"
          />
        </div>

        <div class="mb-6">
          <label for="endDate" class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-2">
            End Date
          </label>
          <input
            type="date"
            id="endDate"
            name="endDate"
            value="<%= endDate %>"
            required
            class="w-full border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 rounded-lg px-3 py-2 text-sm text-gray-700 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent transition"
          />
        </div>

        <button
          type="submit"
          class="w-full bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600 text-white font-medium py-2.5 rounded-lg text-sm transition">
          Apply Date Range
        </button>
      </form>
    </div>
  </div>

  <!-- Footer -->
  <footer class="text-center py-6 text-gray-400 dark:text-gray-500 text-sm">
    Study Time Tracker &copy; <%= new Date().getFullYear() %>
  </footer>

  <!-- Theme toggle script -->
  <script>
    function toggleTheme() {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    }

    // Close modal on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        document.getElementById('customRangeModal').classList.add('hidden');
      }
    });

    // Close modal on backdrop click
    document.getElementById('customRangeModal').addEventListener('click', function(e) {
      if (e.target === this) {
        this.classList.add('hidden');
      }
    });
  </script>

</body>
</html>
