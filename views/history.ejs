<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>History - Study Time Tracker</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">

  <!-- Header -->
  <header class="bg-white border-b border-gray-200 sticky top-0 z-10">
    <div class="max-w-7xl mx-auto px-4 py-4">
      <div class="flex items-center justify-between mb-3">
        <div>
          <h1 class="text-2xl font-bold text-indigo-600">Study History</h1>
          <p class="text-xs text-gray-500">View and analyze your study sessions</p>
        </div>
        <a href="/" class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Dashboard
        </a>
      </div>

      <!-- Period Filters -->
      <div class="flex flex-wrap gap-2">
        <a href="/history?period=today" 
           class="px-3 py-1.5 text-xs font-medium rounded-lg transition <%= period === 'today' ? 'bg-indigo-600 text-white' : 'bg-white text-gray-700 border border-gray-200 hover:bg-gray-50' %>">
          Today
        </a>
        <a href="/history?period=yesterday" 
           class="px-3 py-1.5 text-xs font-medium rounded-lg transition <%= period === 'yesterday' ? 'bg-indigo-600 text-white' : 'bg-white text-gray-700 border border-gray-200 hover:bg-gray-50' %>">
          Yesterday
        </a>
        <a href="/history?period=this-week" 
           class="px-3 py-1.5 text-xs font-medium rounded-lg transition <%= period === 'this-week' ? 'bg-indigo-600 text-white' : 'bg-white text-gray-700 border border-gray-200 hover:bg-gray-50' %>">
          This Week
        </a>
        <a href="/history?period=last-week" 
           class="px-3 py-1.5 text-xs font-medium rounded-lg transition <%= period === 'last-week' ? 'bg-indigo-600 text-white' : 'bg-white text-gray-700 border border-gray-200 hover:bg-gray-50' %>">
          Last Week
        </a>
        <a href="/history?period=this-month" 
           class="px-3 py-1.5 text-xs font-medium rounded-lg transition <%= period === 'this-month' ? 'bg-indigo-600 text-white' : 'bg-white text-gray-700 border border-gray-200 hover:bg-gray-50' %>">
          This Month
        </a>
        <a href="/history?period=last-month" 
           class="px-3 py-1.5 text-xs font-medium rounded-lg transition <%= period === 'last-month' ? 'bg-indigo-600 text-white' : 'bg-white text-gray-700 border border-gray-200 hover:bg-gray-50' %>">
          Last Month
        </a>
        <a href="/history?period=all-time" 
           class="px-3 py-1.5 text-xs font-medium rounded-lg transition <%= period === 'all-time' ? 'bg-indigo-600 text-white' : 'bg-white text-gray-700 border border-gray-200 hover:bg-gray-50' %>">
          All Time
        </a>
        <button 
           onclick="document.getElementById('customRangeModal').classList.remove('hidden')"
           class="px-3 py-1.5 text-xs font-medium rounded-lg transition <%= period === 'custom' ? 'bg-indigo-600 text-white' : 'bg-white text-gray-700 border border-gray-200 hover:bg-gray-50' %>">
          Custom Range
        </button>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-4 py-6 space-y-6">

    <!-- Period Label -->
    <div class="text-center">
      <h2 class="text-lg font-semibold text-gray-800"><%= periodLabel %></h2>
    </div>

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      
      <!-- Total Study Time -->
      <div class="bg-white border border-gray-200 rounded-lg p-5 shadow-sm">
        <div class="flex items-center gap-3 mb-2">
          <div class="bg-indigo-100 rounded-lg p-2">
            <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z" />
            </svg>
          </div>
          <span class="text-sm font-medium text-gray-600">Total Study Time</span>
        </div>
        <div>
          <% const totalHours = Math.floor(totalStudyTime / 60); %>
          <% const totalMins = totalStudyTime % 60; %>
          <p class="text-2xl font-bold text-gray-800">
            <%= totalHours > 0 ? totalHours + 'h ' : '' %><%= totalMins + 'm' %>
          </p>
          <p class="text-xs text-gray-500 mt-1"><%= totalStudyTime %> minutes</p>
        </div>
      </div>

      <!-- Number of Sessions -->
      <div class="bg-white border border-gray-200 rounded-lg p-5 shadow-sm">
        <div class="flex items-center gap-3 mb-2">
          <div class="bg-emerald-100 rounded-lg p-2">
            <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <span class="text-sm font-medium text-gray-600">Sessions</span>
        </div>
        <div>
          <p class="text-2xl font-bold text-gray-800"><%= numberOfSessions %></p>
          <p class="text-xs text-gray-500 mt-1"><%= numberOfSessions === 1 ? 'session' : 'sessions' %> recorded</p>
        </div>
      </div>

      <!-- Average per Session -->
      <div class="bg-white border border-gray-200 rounded-lg p-5 shadow-sm">
        <div class="flex items-center gap-3 mb-2">
          <div class="bg-violet-100 rounded-lg p-2">
            <svg class="w-5 h-5 text-violet-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <span class="text-sm font-medium text-gray-600">Average per Session</span>
        </div>
        <div>
          <% const avgMins = numberOfSessions > 0 ? Math.round(totalStudyTime / numberOfSessions) : 0; %>
          <% const avgHours = Math.floor(avgMins / 60); %>
          <% const avgMinutes = avgMins % 60; %>
          <p class="text-2xl font-bold text-gray-800">
            <%= avgHours > 0 ? avgHours + 'h ' : '' %><%= avgMinutes + 'm' %>
          </p>
          <p class="text-xs text-gray-500 mt-1">per session</p>
        </div>
      </div>

    </div>

    <!-- 2-Column Layout: Subject Stats & Daily Totals -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      
      <!-- Study by Subject -->
      <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-gray-700 mb-4">Study by Subject</h2>
        
        <% if (subjectStats.length > 0) { %>
          <%
            const maxMinutes = subjectStats[0].totalMinutes;
          %>
          <div class="space-y-3">
            <% subjectStats.forEach(stat => { %>
              <%
                const statHours = Math.floor(stat.totalMinutes / 60);
                const statMins = stat.totalMinutes % 60;
                const statTimeStr = (statHours > 0 ? statHours + 'h ' : '') + statMins + 'm';
                const progressWidth = maxMinutes > 0 ? Math.round((stat.totalMinutes / maxMinutes) * 100) : 0;
              %>
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-sm font-medium text-gray-700"><%= stat.subject %></span>
                  <span class="text-sm font-semibold text-indigo-600"><%= statTimeStr %></span>
                </div>
                <div class="w-full bg-gray-100 rounded-full h-2 overflow-hidden">
                  <div
                    class="h-2 bg-indigo-500 rounded-full transition-all duration-500"
                    style="width: <%= progressWidth %>%">
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-8 text-gray-400">
            <p class="text-sm">No study data for this period</p>
          </div>
        <% } %>
      </div>

      <!-- Daily Totals -->
      <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-gray-700 mb-4">Daily Totals</h2>
        
        <% if (dailyTotals.length > 0) { %>
          <div class="space-y-2 max-h-80 overflow-y-auto">
            <% dailyTotals.forEach(day => { %>
              <%
                const dayHours = Math.floor(day.minutes / 60);
                const dayMins = day.minutes % 60;
                const dayTimeStr = (dayHours > 0 ? dayHours + 'h ' : '') + dayMins + 'm';
                const formattedDate = new Date(day.date + 'T00:00:00').toLocaleDateString('en-US', { 
                  weekday: 'short', 
                  month: 'short', 
                  day: 'numeric' 
                });
              %>
              <div class="flex items-center justify-between p-2 hover:bg-gray-50 rounded-lg transition">
                <span class="text-sm text-gray-700"><%= formattedDate %></span>
                <span class="text-sm font-semibold text-indigo-600"><%= dayTimeStr %></span>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-8 text-gray-400">
            <p class="text-sm">No study data for this period</p>
          </div>
        <% } %>
      </div>

    </div>

    <!-- Study Sessions -->
    <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-gray-700 mb-4">Study Sessions (<%= numberOfSessions %>)</h2>

      <% if (groupedSessions.length === 0) { %>
        <!-- Empty state -->
        <div class="text-center py-12 text-gray-400">
          <svg class="w-14 h-14 mx-auto mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z" />
          </svg>
          <p class="text-base">No sessions found</p>
          <p class="text-sm mt-1">Try selecting a different period</p>
        </div>
      <% } else { %>
        <div class="space-y-4">
          <% groupedSessions.forEach(group => { %>
            <%
              const dh = Math.floor(group.total / 60);
              const dm = group.total % 60;
              const dailyTotalStr = (dh > 0 ? dh + 'h ' : '') + dm + 'm';
            %>
            <div class="border border-gray-200 rounded-lg overflow-hidden">

              <!-- Date header -->
              <div class="flex items-center justify-between px-4 py-2.5 bg-gray-50 border-b border-gray-200">
                <span class="text-sm font-semibold text-gray-700"><%= group.label %></span>
                <span class="text-xs font-medium text-indigo-600 bg-indigo-50 px-2 py-1 rounded">
                  Total: <%= dailyTotalStr %>
                </span>
              </div>

              <!-- Sessions for this day -->
              <div class="divide-y divide-gray-100">
                <% group.sessions.forEach(session => { %>
                  <%
                    const h = Math.floor(session.duration / 60);
                    const m = session.duration % 60;
                    const durationStr = (h > 0 ? h + 'h ' : '') + m + 'm';
                  %>
                  <div class="px-4 py-3 flex items-center justify-between gap-4 hover:bg-gray-50 transition">
                    <div class="flex items-center gap-3 min-w-0 flex-1">
                      <div class="bg-indigo-100 text-indigo-600 rounded-lg p-2 shrink-0">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                        </svg>
                      </div>
                      <p class="text-sm font-medium text-gray-700 truncate"><%= session.subject %></p>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                      <span class="text-sm font-medium text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded">
                        <%= durationStr %>
                      </span>
                      <a
                        href="/study/<%= session._id %>/edit"
                        class="text-xs text-gray-600 hover:text-indigo-600 hover:bg-indigo-50 border border-gray-300 hover:border-indigo-300 px-2 py-1 rounded transition">
                        Edit
                      </a>
                      <form method="POST" action="/study/<%= session._id %>?_method=DELETE" class="inline">
                        <button
                          type="submit"
                          onclick="return confirm('Delete this session?')"
                          class="text-xs text-gray-600 hover:text-red-600 hover:bg-red-50 border border-gray-300 hover:border-red-300 px-2 py-1 rounded transition">
                          Delete
                        </button>
                      </form>
                    </div>
                  </div>
                <% }) %>
              </div>

            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

  </div>

  <!-- Custom Date Range Modal -->
  <div id="customRangeModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-lg shadow-xl max-w-md w-full p-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-semibold text-gray-700">Custom Date Range</h2>
        <button
          onclick="document.getElementById('customRangeModal').classList.add('hidden')"
          class="text-gray-400 hover:text-gray-600 transition">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form method="GET" action="/history">
        <input type="hidden" name="period" value="custom" />
        
        <div class="mb-4">
          <label for="startDate" class="block text-sm font-medium text-gray-600 mb-2">
            Start Date
          </label>
          <input
            type="date"
            id="startDate"
            name="startDate"
            value="<%= startDate %>"
            required
            class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent transition"
          />
        </div>

        <div class="mb-4">
          <label for="endDate" class="block text-sm font-medium text-gray-600 mb-2">
            End Date
          </label>
          <input
            type="date"
            id="endDate"
            name="endDate"
            value="<%= endDate %>"
            required
            class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent transition"
          />
        </div>

        <button
          type="submit"
          class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 rounded-lg text-sm transition">
          Apply Date Range
        </button>
      </form>
    </div>
  </div>

  <!-- Footer -->
  <footer class="text-center py-6 text-gray-400 text-sm">
    Study Time Tracker &copy; <%= new Date().getFullYear() %>
  </footer>

</body>
</html>
